@model Oceanic_Horizon_Travel.DTOs.MemberDtos.ProfileViewModel

@{
    ViewData["Title"] = "Hesabım";
    var m = Model.Member;
    var initial = string.IsNullOrWhiteSpace(m.FirstName) ? "?" : m.FirstName[..1].ToUpper();
}

<div class="mx-auto max-w-6xl px-6 py-12">

    <!-- ust cards -->
    <div class="mb-8 rounded-card border border-line bg-white p-8 shadow-soft">
        <div class="flex flex-wrap items-center gap-6">

            <span class="grid h-20 w-20 shrink-0 place-items-center rounded-full bg-navy font-display text-2xl font-bold text-white">
                @initial
            </span>

            <div class="min-w-0 flex-1">
                <h1 class="font-display text-2xl font-bold text-navy">@m.FirstName @m.LastName</h1>
                <p class="mt-1 text-sm text-muted">@m.Email</p>
                @if (!string.IsNullOrWhiteSpace(m.PhoneNumber))
                {
                    <p class="text-sm text-muted">@m.PhoneNumber</p>
                }
                <p class="mt-2 text-xs text-muted">
                    Üyelik tarihi: @m.CreatedDate.ToString("dd.MM.yyyy")
                </p>
            </div>

            <a asp-controller="Auth" asp-action="Logout"
               class="rounded-full border border-line px-5 py-2.5 text-sm font-semibold text-muted transition hover:border-navy hover:text-navy">
                Çıkış Yap
            </a>
        </div>

        <!-- loops -->
        <div class="mt-8 grid gap-4 border-t border-line pt-6 sm:grid-cols-3">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-muted">Toplam Rezervasyon</p>
                <p class="mt-1 font-display text-2xl font-bold text-navy">@Model.TotalBookings</p>
            </div>
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-muted">Onaylanan</p>
                <p class="mt-1 font-display text-2xl font-bold text-teal-dark">@Model.ActiveBookings</p>
            </div>
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-muted">Toplam Harcama</p>
                <p class="mt-1 font-display text-2xl font-bold text-navy">@Model.TotalSpent.ToString("N0")</p>
            </div>
        </div>
    </div>

    <!-- Rezervasyonlar-->
    <div>
        <h2 class="mb-5 font-display text-xl font-bold text-navy">Rezervasyonlarım</h2>

        @if (!Model.Bookings.Any())
        {
            <div class="rounded-card border border-line bg-white px-8 py-16 text-center shadow-soft">
                <div class="mx-auto mb-5 grid h-16 w-16 place-items-center rounded-2xl bg-teal/10 text-teal-dark">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="7" width="20" height="14" rx="2" />
                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                    </svg>
                </div>
                <h3 class="font-display text-xl font-bold text-navy">Henüz rezervasyonun yok</h3>
                <p class="mx-auto mt-2 max-w-sm text-muted">İlk yolculuğunu planlamaya ne dersin?</p>
                <a asp-controller="Tour" asp-action="Index"
                   class="mt-6 inline-block rounded-full bg-teal px-6 py-3 font-semibold text-white transition hover:bg-teal-dark">
                    Turları Keşfet
                </a>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var b in Model.Bookings)
                {
                    <details class="group overflow-hidden rounded-card border border-line bg-white shadow-soft">

                        <summary class="cursor-pointer list-none p-6 transition hover:bg-cream/30">
                            <div class="flex flex-wrap items-start justify-between gap-4">

                                <div class="min-w-0 flex-1">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="font-mono text-xs font-bold text-teal-dark">@b.BookingNumber</span>

                                        @if (b.Status == "Onaylandı")
                                        {
                                            <span class="rounded-full bg-teal/12 px-3 py-1 text-xs font-semibold text-teal-dark">Onaylandı</span>
                                        }
                                        else if (b.Status == "İptal Edildi")
                                        {
                                            <span class="rounded-full bg-line px-3 py-1 text-xs font-semibold text-muted">İptal Edildi</span>
                                        }
                                        else
                                        {
                                            <span class="rounded-full bg-star/15 px-3 py-1 text-xs font-semibold text-star">Onay Bekliyor</span>
                                        }

                                        @if (b.PaymentStatus == "Ödendi")
                                        {
                                            <span class="rounded-full bg-teal/12 px-3 py-1 text-xs font-semibold text-teal-dark">Ödendi</span>
                                        }
                                    </div>

                                    <h3 class="mt-2 font-display text-lg font-bold text-navy">@b.TourTitle</h3>

                                    <p class="mt-1 text-sm text-muted">
                                        @b.AdultCount yetişkin
                                        @if (b.ChildCount > 0)
                                        {
                                            <span>· @b.ChildCount çocuk</span>
                                        }
                                        · @b.BookingDate.ToString("dd.MM.yyyy") tarihinde oluşturuldu
                                    </p>
                                </div>

                                <div class="flex items-center gap-4">
                                    <div class="text-right">
                                        <p class="font-display text-xl font-bold text-navy">@b.TotalPrice.ToString("N0")</p>
                                        @if (b.PaymentStatus != "Ödendi" && b.Status != "İptal Edildi")
                                        {
                                            <p class="mt-1 text-xs text-muted">Ödeme bekleniyor</p>
                                        }
                                    </div>

                                    <svg class="h-5 w-5 shrink-0 text-muted transition group-open:rotate-180"
                                         viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="6 9 12 15 18 9" />
                                    </svg>
                                </div>
                            </div>
                        </summary>

                        <!-- açılan kısım -->
                        <div class="border-t border-line bg-cream/30 px-6 py-5">
                            <p class="mb-3 text-xs font-bold uppercase tracking-wider text-muted">
                                Katılımcılar (@b.Guests.Count kişi)
                            </p>

                            @if (!b.Guests.Any())
                            {
                                <p class="text-sm text-muted">Katılımcı bilgisi girilmemiş.</p>
                            }
                            else
                            {
                                <div class="overflow-hidden rounded-xl border border-line bg-white">
                                    <div class="overflow-x-auto">
                                        <table class="w-full table-fixed text-left text-sm">
                                            <thead class="border-b border-line bg-cream/60">
                                                <tr>
                                                    <th class="w-[8%] px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-muted">#</th>
                                                    <th class="w-[38%] px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-muted">Ad Soyad</th>
                                                    <th class="w-[32%] px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-muted">Kimlik / Pasaport</th>
                                                    <th class="w-[22%] px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-muted">Doğum Tarihi</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{
                                                    var no = 1;
                                                }
                                                @foreach (var g in b.Guests)
                                                {
                                                    <tr class="border-b border-line last:border-0">
                                                        <td class="px-4 py-2.5 text-muted">@(no++)</td>
                                                        <td class="px-4 py-2.5 font-semibold text-navy">@g.FirstName @g.LastName</td>
                                                        <td class="px-4 py-2.5 font-mono text-xs text-muted">@g.IdentityNumber</td>
                                                        <td class="whitespace-nowrap px-4 py-2.5 text-muted">@g.BirthDate.ToString("dd.MM.yyyy")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>

                    </details>

                }
            </div>
        }
    </div>
</div>
