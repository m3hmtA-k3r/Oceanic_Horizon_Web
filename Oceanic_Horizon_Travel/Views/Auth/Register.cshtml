@model Oceanic_Horizon_Travel.DTOs.MemberDtos.RegisterMemberDto

@{
    ViewData["Title"] = "Hesap Oluştur";
    Layout = "_AuthLayout";
}

<div class="flex min-h-screen flex-col lg:flex-row">

    <!-- SOL GÖRSEL -->
    <div class="relative flex flex-col justify-between overflow-hidden bg-[url('https://images.unsplash.com/photo-1523906834658-6e24ef2386f9?auto=format&fit=crop&w=1400&q=80')] bg-cover bg-center px-6 pb-8 pt-6 text-white lg:min-h-screen lg:w-1/2 lg:px-[2.8rem] lg:py-[2.4rem]">

        <div class="absolute inset-0 bg-[linear-gradient(160deg,rgba(14,42,59,.72)_0%,rgba(14,42,59,.45)_45%,rgba(11,127,128,.6)_100%)]"></div>

        <a asp-controller="Home" asp-action="Index"
           class="relative z-10 flex items-center gap-2 font-display text-2xl font-extrabold tracking-[-.5px] text-white">
            <span class="h-[11px] w-[11px] rounded-full bg-teal ring-4 ring-white/20"></span>
            Oceanic Horizon
        </a>

        <div class="relative z-10 max-w-[30rem] py-5 lg:py-0">
            <div class="font-display text-[.72rem] font-bold uppercase tracking-[.22em] text-teal-light">
                Oceanic Horizon topluluğuna katıl
            </div>
            <h1 class="my-3 font-display text-[1.6rem] font-extrabold leading-[1.12] tracking-[-.5px] lg:text-[clamp(1.9rem,3vw,2.7rem)]">
                Yeni Maceraların Burada Başlıyor
            </h1>
            <p class="mb-6 text-[1.02rem] leading-relaxed text-white/[.88]">
                Oceanic Horizon hesabını oluştur, favori rotalarını kaydet, turlarını yönet ve seyahat deneyimlerini paylaş.
            </p>

            <ul class="hidden lg:block">
                <li class="mb-2.5 flex items-center gap-2.5 text-[.96rem] text-white/95">
                    <span class="grid h-7 w-7 flex-none place-items-center rounded-[9px] border border-white/25 bg-white/[.16] text-teal-light">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" /></svg>
                    </span>
                    Favori turlarını kaydet
                </li>
                <li class="mb-2.5 flex items-center gap-2.5 text-[.96rem] text-white/95">
                    <span class="grid h-7 w-7 flex-none place-items-center rounded-[9px] border border-white/25 bg-white/[.16] text-teal-light">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18v12H3z" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                    </span>
                    Rezervasyonlarını tek yerden yönet
                </li>
                <li class="mb-2.5 flex items-center gap-2.5 text-[.96rem] text-white/95">
                    <span class="grid h-7 w-7 flex-none place-items-center rounded-[9px] border border-white/25 bg-white/[.16] text-teal-light">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                    </span>
                    Yorum ve değerlendirmelerini paylaş
                </li>
            </ul>
        </div>

        <div class="relative z-10 hidden text-[.82rem] text-white/60 lg:block">
            &copy; @DateTime.Now.Year Oceanic Horizon &middot; Dünyayı keşfetmeye hazır ol.
        </div>
    </div>

    <!-- SAĞ FORM -->
    <div class="flex flex-col lg:min-h-screen lg:w-1/2">

        <div class="hidden justify-end px-8 pt-[1.6rem] lg:flex">
            <a asp-controller="Home" asp-action="Index"
               class="inline-flex items-center gap-1.5 text-[.88rem] font-semibold text-muted transition hover:text-teal-dark">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
                Ana Sayfaya Dön
            </a>
        </div>

        <div class="flex flex-1 items-center justify-center px-6 pb-12 pt-8 lg:px-8 lg:pb-12 lg:pt-6">
            <div class="w-full max-w-[440px]">

                <div class="mb-1.5 font-display text-[.72rem] font-bold uppercase tracking-[.22em] text-teal-dark">
                    Oceanic Horizon'a Hoş Geldin
                </div>
                <h2 class="mb-1.5 font-display text-[1.9rem] font-extrabold tracking-[-.5px] text-navy">
                    Hesabını Oluştur
                </h2>
                <p class="mb-6 text-[.94rem] text-muted">
                    Seyahatlerini planlamak ve yönetmek için birkaç bilgi yeterli.
                </p>

                @* Alana bağlı olmayan hatalar — ör. "Bu E-Posta daha önce kullanıldı" *@
                @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div asp-validation-summary="ModelOnly"
                         class="mb-4 rounded-xl border border-danger-line bg-danger/5 px-4 py-3 text-[.82rem] text-danger [&_ul]:m-0 [&_ul]:list-none [&_ul]:p-0"></div>
                }

                <form asp-controller="Auth" asp-action="Register" method="post">

                    <div class="flex gap-[.8rem]">
                        <div class="mb-4 flex-1">
                            <label asp-for="FirstName" class="mb-1.5 block text-[.8rem] font-semibold text-navy">Ad</label>
                            <input asp-for="FirstName" placeholder="Adınız" autocomplete="given-name"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 text-[.94rem] text-navy transition placeholder:text-placeholder focus:border-teal focus:outline-none focus:ring-[3px] focus:ring-teal/[.12]" />
                            <span asp-validation-for="FirstName" class="mt-1.5 block text-[.78rem] text-danger"></span>
                        </div>

                        <div class="mb-4 flex-1">
                            <label asp-for="LastName" class="mb-1.5 block text-[.8rem] font-semibold text-navy">Soyad</label>
                            <input asp-for="LastName" placeholder="Soyadınız" autocomplete="family-name"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 text-[.94rem] text-navy transition placeholder:text-placeholder focus:border-teal focus:outline-none focus:ring-[3px] focus:ring-teal/[.12]" />
                            <span asp-validation-for="LastName" class="mt-1.5 block text-[.78rem] text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Email" class="mb-1.5 block text-[.8rem] font-semibold text-navy">E-posta</label>
                        <input asp-for="Email" type="email" placeholder="ornek@email.com" autocomplete="email"
                               class="w-full rounded-xl border border-line bg-white px-4 py-3 text-[.94rem] text-navy transition placeholder:text-placeholder focus:border-teal focus:outline-none focus:ring-[3px] focus:ring-teal/[.12]" />
                        <span asp-validation-for="Email" class="mt-1.5 block text-[.78rem] text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="mb-1.5 block text-[.8rem] font-semibold text-navy">Telefon</label>
                        <input asp-for="PhoneNumber" type="tel" placeholder="+90 5XX XXX XX XX" autocomplete="tel"
                               class="w-full rounded-xl border border-line bg-white px-4 py-3 text-[.94rem] text-navy transition placeholder:text-placeholder focus:border-teal focus:outline-none focus:ring-[3px] focus:ring-teal/[.12]" />
                        <span asp-validation-for="PhoneNumber" class="mt-1.5 block text-[.78rem] text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="mb-1.5 block text-[.8rem] font-semibold text-navy">Şifre</label>
                        <input asp-for="Password" type="password" placeholder="Şifrenizi oluşturun" autocomplete="new-password"
                               class="w-full rounded-xl border border-line bg-white px-4 py-3 text-[.94rem] text-navy transition placeholder:text-placeholder focus:border-teal focus:outline-none focus:ring-[3px] focus:ring-teal/[.12]" />
                        <div class="mt-1.5 text-[.76rem] text-muted">En az 6 karakter kullan.</div>
                        <span asp-validation-for="Password" class="mt-1.5 block text-[.78rem] text-danger"></span>
                    </div>

                    <div class="mb-6">
                        <label asp-for="ConfirmPassword" class="mb-1.5 block text-[.8rem] font-semibold text-navy">Şifre Tekrar</label>
                        <input asp-for="ConfirmPassword" type="password" placeholder="Şifrenizi tekrar girin" autocomplete="new-password"
                               class="w-full rounded-xl border border-line bg-white px-4 py-3 text-[.94rem] text-navy transition placeholder:text-placeholder focus:border-teal focus:outline-none focus:ring-[3px] focus:ring-teal/[.12]" />
                        <span asp-validation-for="ConfirmPassword" class="mt-1.5 block text-[.78rem] text-danger"></span>
                    </div>

                    <button type="submit"
                            class="w-full rounded-full bg-teal px-6 py-[.85rem] font-semibold text-white transition duration-200 hover:bg-teal-dark hover:shadow-[0_12px_26px_rgba(15,163,163,.32)]">
                        Hesap Oluştur
                    </button>
                </form>

                <div class="my-[1.4rem] flex items-center gap-4 text-[.82rem] text-muted">
                    <span class="h-px flex-1 bg-line"></span>veya<span class="h-px flex-1 bg-line"></span>
                </div>

                <button type="button"
                        class="flex w-full items-center justify-center gap-2.5 rounded-full border border-line bg-white px-4 py-[.8rem] text-[.92rem] font-semibold text-navy transition hover:border-teal hover:shadow-soft">
                    <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z" /><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z" /><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z" /><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z" /></svg>
                    Google ile devam et
                </button>

                <div class="mt-[1.4rem] text-center text-[.9rem] text-muted">
                    Zaten hesabın var mı?
                    <a asp-controller="Auth" asp-action="Login" class="font-semibold text-teal-dark hover:underline">Giriş Yap</a>
                </div>

            </div>
        </div>
    </div>
</div>
