<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Oceanic_Horizon_Travel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />


    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Oceanic_Horizon_Travel.styles.css" asp-append-version="true" />

</head>
<body class="font-body bg-cream text-navy">

    <header class="sticky top-0 z-50 bg-cream/85 backdrop-blur-md border-b border-line">
        <div class="max-w-7xl mx-auto px-4">
            <nav class="flex items-center justify-between py-4">

                <!-- Logo -->
                <a asp-controller="Home" asp-action="Index"
                   class="flex items-center gap-2 font-display font-extrabold text-2xl tracking-tight text-navy">
                    <span class="w-3 h-3 rounded-full bg-teal ring-4 ring-teal/20"></span>
                    Oceanic Horizon
                </a>

                <!-- Menü -->
                <ul class="hidden lg:flex items-center gap-1">
                    <li><a href="/" class="px-3 py-2 font-medium text-navy hover:text-teal-dark transition">Ana Sayfa</a></li>
                    <li><a href="/#turlar" class="px-3 py-2 font-medium text-navy hover:text-teal-dark transition">Turlar</a></li>
                    <li><a href="/#destinasyonlar" class="px-3 py-2 font-medium text-navy hover:text-teal-dark transition">Destinasyonlar</a></li>
                    <li><a href="/#konaklama" class="px-3 py-2 font-medium text-navy hover:text-teal-dark transition">Konaklama</a></li>
                    <li><a href="/#hakkimizda" class="px-3 py-2 font-medium text-navy hover:text-teal-dark transition">Hakkımızda</a></li>
                    <li><a href="/#iletisim" class="px-3 py-2 font-medium text-navy hover:text-teal-dark transition">İletişim</a></li>
                </ul>

                <!-- Sağ taraf: giriş durumuna göre değişir -->
                @if (User.Identity!.IsAuthenticated)
                {
                    <div class="flex items-center gap-2">
                        <span class="hidden sm:flex items-center gap-2.5 rounded-full border border-line bg-white py-1.5 pl-4 pr-1.5 font-semibold text-navy">
                            @User.Identity.Name
                            <span class="grid h-8 w-8 place-items-center rounded-full bg-navy text-xs font-bold text-white">
                                @User.Identity.Name!.Substring(0, 1).ToUpper()
                            </span>
                        </span>

                        <a asp-controller="Auth" asp-action="Logout"
                           class="rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-muted hover:text-navy hover:border-navy transition">
                            Çıkış
                        </a>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-2">
                        <a asp-controller="Auth" asp-action="Login"
                           class="px-4 py-2 font-medium text-navy hover:text-teal-dark transition">
                            Giriş Yap
                        </a>
                        <a asp-controller="Auth" asp-action="Register"
                           class="rounded-full bg-teal px-5 py-2.5 font-semibold text-white transition duration-200 hover:bg-teal-dark hover:-translate-y-0.5">
                            Kayıt Ol
                        </a>
                    </div>
                }
            </nav>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>


    <footer class="bg-navy text-white/70 pt-16 pb-8">

        <div class="max-w-7xl mx-auto px-4">

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

                <!-- Marka -->
                <div>
                    <a asp-controller="Home" asp-action="Index"
                       class="flex items-center gap-2 font-display font-extrabold text-2xl tracking-tight text-white mb-4">
                        <span class="w-3 h-3 rounded-full bg-teal ring-4 ring-teal/20"></span>
                        Oceanic Horizon
                    </a>
                    <p class="text-sm leading-relaxed max-w-[34ch]">
                        Dünyanın dört bir yanına, özenle tasarlanmış turlarla unutulmaz seyahatler.
                    </p>

                    <div class="flex gap-2 mt-5">
                        <a href="#" aria-label="Instagram" class="grid h-9 w-9 place-items-center rounded-full bg-white/10 hover:bg-teal transition">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" /></svg>
                        </a>
                        <a href="#" aria-label="Facebook" class="grid h-9 w-9 place-items-center rounded-full bg-white/10 hover:bg-teal transition">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg>
                        </a>
                        <a href="#" aria-label="Youtube" class="grid h-9 w-9 place-items-center rounded-full bg-white/10 hover:bg-teal transition">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.5-.45-5.17a2.6 2.6 0 0 0-1.83-1.84C19.05 4.55 12 4.55 12 4.55s-7.05 0-8.72.44A2.6 2.6 0 0 0 1.45 6.83C1 8.5 1 12 1 12s0 3.5.45 5.17a2.6 2.6 0 0 0 1.83 1.84c1.67.44 8.72.44 8.72.44s7.05 0 8.72-.44a2.6 2.6 0 0 0 1.83-1.84C23 15.5 23 12 23 12zM9.75 15.02V8.98L15.5 12l-5.75 3.02z" /></svg>
                        </a>
                    </div>
                </div>

                <!-- Keşfet -->
                <div>
                    <h6 class="font-display font-semibold text-white mb-4">Keşfet</h6>
                    <a href="/#turlar" class="block mb-2.5 text-sm hover:text-teal-light transition">Turlar</a>
                    <a href="/#destinasyonlar" class="block mb-2.5 text-sm hover:text-teal-light transition">Destinasyonlar</a>
                    <a href="/#konaklama" class="block mb-2.5 text-sm hover:text-teal-light transition">Konaklama</a>
                    <a href="/#yorumlar" class="block mb-2.5 text-sm hover:text-teal-light transition">Yorumlar</a>
                </div>

                <!-- Kurumsal -->
                <div>
                    <h6 class="font-display font-semibold text-white mb-4">Kurumsal</h6>
                    <a href="/#hakkimizda" class="block mb-2.5 text-sm hover:text-teal-light transition">Hakkımızda</a>
                    <a href="/#iletisim" class="block mb-2.5 text-sm hover:text-teal-light transition">İletişim</a>
                    <a asp-controller="Auth" asp-action="Register" class="block mb-2.5 text-sm hover:text-teal-light transition">Ev Sahibi Ol</a>
                    <a href="#" class="block mb-2.5 text-sm hover:text-teal-light transition">Blog</a>
                </div>

                <!-- Bülten -->
                <div>
                    <h6 class="font-display font-semibold text-white mb-4">Bültene Katıl</h6>
                    <p class="text-sm leading-relaxed max-w-[36ch] mb-4">
                        Yeni rotalardan ve erken rezervasyon fırsatlarından ilk sen haberdar ol.
                    </p>
                    <div class="flex gap-2 max-w-[360px]">
                        <input type="email" placeholder="E-posta adresin"
                               class="flex-1 rounded-full bg-white/10 border border-white/15 px-4 py-2.5 text-sm text-white placeholder:text-white/50 focus:outline-none focus:border-teal transition" />
                        <button class="rounded-full bg-teal px-5 py-2.5 text-sm font-semibold text-white whitespace-nowrap hover:bg-teal-dark transition">
                            Katıl
                        </button>
                    </div>
                </div>
            </div>

            <!-- Alt şerit -->
            <div class="flex flex-wrap justify-between gap-2 border-t border-white/10 mt-10 pt-6 text-sm">
                <span>&copy; @DateTime.Now.Year Oceanic Horizon Travel. Tüm hakları saklıdır.</span>
                <span>Gizlilik · Kullanım Koşulları · Çerezler</span>
            </div>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
