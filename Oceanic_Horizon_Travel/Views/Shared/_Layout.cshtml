@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L

@{
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    var userName = User.Identity?.Name ?? "";
    var userInitial = string.IsNullOrWhiteSpace(userName) ? "?" : userName[..1].ToUpper();

    var cultureNames = new Dictionary<string, string>
    {
        ["tr"] = "Türkçe",
        ["en"] = "English",
        ["pt"] = "Português"
    };
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Oceanic Horizon — özenle tasarlanmış turlarla unutulmaz seyahatler." />

    <title>@ViewData["Title"] - Oceanic Horizon</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
</head>
<body class="font-body bg-cream text-navy">

    <header class="sticky top-0 z-50 border-b border-line bg-cream/85 backdrop-blur-md">
        <div class="mx-auto max-w-7xl px-4">
            <nav class="flex items-center justify-between py-4">

                <!-- Logo -->
                <a asp-controller="Home" asp-action="Index"
                   class="flex items-center gap-2 font-display text-2xl font-extrabold tracking-tight text-navy">
                    <span class="h-3 w-3 rounded-full bg-teal ring-4 ring-teal/20"></span>
                    Oceanic Horizon
                </a>

                <!-- Menü -->
                <ul class="hidden items-center gap-1 lg:flex">
                    <li>
                        <a asp-controller="Home" asp-action="Index"
                           class="px-3 py-2 font-medium text-navy transition hover:text-teal-dark">@L["Home"]</a>
                    </li>
                    <li>
                        <a asp-controller="Tour" asp-action="Index"
                           class="px-3 py-2 font-medium text-navy transition hover:text-teal-dark">@L["Tours"]</a>
                    </li>
                    <li><a href="/#destinasyonlar" class="px-3 py-2 font-medium text-navy transition hover:text-teal-dark">@L["Destinations"]</a></li>
                    <li><a href="/#konaklama" class="px-3 py-2 font-medium text-navy transition hover:text-teal-dark">@L["Accommodation"]</a></li>
                    <li><a href="/#hakkimizda" class="px-3 py-2 font-medium text-navy transition hover:text-teal-dark">@L["About"]</a></li>
                    <li><a href="/#iletisim" class="px-3 py-2 font-medium text-navy transition hover:text-teal-dark">@L["Contact"]</a></li>
                </ul>

                <!-- Sağ taraf: dil seçici + giriş durumu -->
                <div class="flex items-center gap-3">

                    <!-- Dil seçici -->
                    <details class="group relative">
                        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-navy transition hover:border-navy">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10" />
                                <line x1="2" y1="12" x2="22" y2="12" />
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                            </svg>
                            <span class="hidden sm:inline">@cultureNames[currentCulture]</span>
                            <span class="sm:hidden">@currentCulture.ToUpper()</span>
                            <svg class="transition group-open:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                <polyline points="6 9 12 15 18 9" />
                            </svg>
                        </summary>

                        <div class="absolute right-0 z-50 mt-2 w-44 overflow-hidden rounded-xl border border-line bg-white shadow-lift">
                            @foreach (var item in cultureNames)
                            {
                                <a asp-controller="Language" asp-action="Change"
                                   asp-route-culture="@item.Key" asp-route-returnUrl="@returnUrl"
                                   class="block px-4 py-2.5 text-sm transition hover:bg-cream @(item.Key == currentCulture ? "bg-cream font-semibold text-teal-dark" : "text-navy")">
                                    @item.Value
                                </a>
                            }
                        </div>
                    </details>

                    @if (User.Identity!.IsAuthenticated)
                    {
                        <div class="flex items-center gap-2">

                            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                            {
                                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                                   class="hidden rounded-full border border-navy bg-navy px-4 py-2 text-sm font-semibold text-white transition hover:bg-navy-2 md:inline-block">
                                    @L["AdminPanel"]
                                </a>
                            }

                            <span class="hidden items-center gap-2.5 rounded-full border border-line bg-white py-1.5 pl-4 pr-1.5 font-semibold text-navy sm:flex">
                                @userName
                                <span class="grid h-8 w-8 place-items-center rounded-full bg-navy text-xs font-bold text-white">
                                    @userInitial
                                </span>
                            </span>

                            <a asp-controller="Auth" asp-action="Logout"
                               class="rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-muted transition hover:border-navy hover:text-navy">
                                @L["Logout"]
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-2">
                            <a asp-controller="Auth" asp-action="Login"
                               class="px-4 py-2 font-medium text-navy transition hover:text-teal-dark">
                                @L["Login"]
                            </a>
                            <a asp-controller="Auth" asp-action="Register"
                               class="rounded-full bg-teal px-5 py-2.5 font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-teal-dark">
                                @L["Register"]
                            </a>
                        </div>
                    }
                </div>

            </nav>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="bg-navy pb-8 pt-16 text-white/70">
        <div class="mx-auto max-w-7xl px-4">

            <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4">

                <!-- Marka -->
                <div>
                    <a asp-controller="Home" asp-action="Index"
                       class="mb-4 flex items-center gap-2 font-display text-2xl font-extrabold tracking-tight text-white">
                        <span class="h-3 w-3 rounded-full bg-teal ring-4 ring-teal/20"></span>
                        Oceanic Horizon
                    </a>

                    <p class="max-w-[34ch] text-sm leading-relaxed">@L["FooterTagline"]</p>

                    <div class="mt-5 flex gap-2">
                        <a href="#" aria-label="Instagram" class="grid h-9 w-9 place-items-center rounded-full bg-white/10 transition hover:bg-teal">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" /></svg>
                        </a>
                        <a href="#" aria-label="Facebook" class="grid h-9 w-9 place-items-center rounded-full bg-white/10 transition hover:bg-teal">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg>
                        </a>
                        <a href="#" aria-label="Youtube" class="grid h-9 w-9 place-items-center rounded-full bg-white/10 transition hover:bg-teal">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.5-.45-5.17a2.6 2.6 0 0 0-1.83-1.84C19.05 4.55 12 4.55 12 4.55s-7.05 0-8.72.44A2.6 2.6 0 0 0 1.45 6.83C1 8.5 1 12 1 12s0 3.5.45 5.17a2.6 2.6 0 0 0 1.83 1.84c1.67.44 8.72.44 8.72.44s7.05 0 8.72-.44a2.6 2.6 0 0 0 1.83-1.84C23 15.5 23 12 23 12zM9.75 15.02V8.98L15.5 12l-5.75 3.02z" /></svg>
                        </a>
                    </div>
                </div>

                <!-- Keşfet -->
                <div>
                    <h6 class="mb-4 font-display font-semibold text-white">@L["Discover"]</h6>
                    <a asp-controller="Tour" asp-action="Index" class="mb-2.5 block text-sm transition hover:text-teal-light">@L["Tours"]</a>
                    <a href="/#destinasyonlar" class="mb-2.5 block text-sm transition hover:text-teal-light">@L["Destinations"]</a>
                    <a href="/#konaklama" class="mb-2.5 block text-sm transition hover:text-teal-light">@L["Accommodation"]</a>
                    <a href="/#yorumlar" class="mb-2.5 block text-sm transition hover:text-teal-light">@L["Reviews"]</a>
                </div>

                <!-- Kurumsal -->
                <div>
                    <h6 class="mb-4 font-display font-semibold text-white">@L["Corporate"]</h6>
                    <a href="/#hakkimizda" class="mb-2.5 block text-sm transition hover:text-teal-light">@L["About"]</a>
                    <a href="/#iletisim" class="mb-2.5 block text-sm transition hover:text-teal-light">@L["Contact"]</a>
                    <a asp-controller="Auth" asp-action="Register" class="mb-2.5 block text-sm transition hover:text-teal-light">@L["BecomeHost"]</a>
                    <a href="#" class="mb-2.5 block text-sm transition hover:text-teal-light">@L["Blog"]</a>
                </div>

                <!-- Bülten -->
                <div>
                    <h6 class="mb-4 font-display font-semibold text-white">@L["Newsletter"]</h6>
                    <p class="mb-4 max-w-[36ch] text-sm leading-relaxed">@L["NewsletterText"]</p>

                    <div class="flex max-w-[360px] gap-2">
                        <input type="email" placeholder="@L["EmailPlaceholder"]"
                               class="flex-1 rounded-full border border-white/15 bg-white/10 px-4 py-2.5 text-sm text-white placeholder:text-white/50 transition focus:border-teal focus:outline-none" />
                        <button class="whitespace-nowrap rounded-full bg-teal px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-dark">
                            @L["Join"]
                        </button>
                    </div>
                </div>
            </div>

            <!-- Alt şerit -->
            <div class="mt-10 flex flex-wrap justify-between gap-2 border-t border-white/10 pt-6 text-sm">
                <span>&copy; @DateTime.Now.Year Oceanic Horizon Travel. @L["AllRightsReserved"]</span>
                <span>@L["Privacy"] · @L["Terms"] · @L["Cookies"]</span>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
