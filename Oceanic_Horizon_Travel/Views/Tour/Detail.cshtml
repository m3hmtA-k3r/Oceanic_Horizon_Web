@using System.Globalization
@model Oceanic_Horizon_Travel.DTOs.TourDtos.TourDetailViewModel

@{
    var t = Model.Tour;
    var culture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    ViewData["Title"] = t.Title.Get(culture);

    var totalReviews = Model.RatingDistribution.Values.Sum();
    var openDates = t.TourDates.Where(d => d.Status == "Açık" && d.AvailableSeats > 0)
                               .OrderBy(d => d.StartDate).ToList();
}

<!-- hero-->
<section class="relative h-[420px] overflow-hidden">
    <img src="@t.ThumbnailUrl" alt="@t.Title.Get(culture)" class="h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/50 to-navy/20"></div>

    <div class="absolute inset-x-0 bottom-0">
        <div class="mx-auto max-w-7xl px-6 pb-10">

            <div class="flex flex-wrap items-center gap-2">
                @foreach (var badge in t.Badges)
                {
                    <span class="rounded-full bg-white/95 px-3 py-1 text-xs font-semibold text-navy">@badge</span>
                }
                @if (!string.IsNullOrEmpty(Model.CategoryName))
                {
                    <span class="rounded-full bg-teal px-3 py-1 text-xs font-semibold text-white">@Model.CategoryName</span>
                }
            </div>

            <h1 class="mt-3 font-display text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
                @t.Title.Get(culture)
            </h1>

            <div class="mt-3 flex flex-wrap items-center gap-5 text-sm text-white/80">
                @if (!string.IsNullOrEmpty(Model.DestinationName))
                {
                    <span>@Model.DestinationName</span>
                }
                <span>@t.Day gün · @t.Night gece</span>
                @if (t.ReviewCount > 0)
                {
                    <span class="font-semibold text-white">
                        <span class="text-star">★</span> @t.Rating.ToString("0.0")
                        <span class="font-normal text-white/70">(@t.ReviewCount değerlendirme)</span>
                    </span>
                }
            </div>
        </div>
    </div>
</section>

<div class="mx-auto max-w-7xl px-6 py-12">
    @if (TempData["FormSuccess"] is not null)
    {
        <div class="mb-6 rounded-xl border border-teal/30 bg-teal/10 px-5 py-4 text-sm font-semibold text-teal-dark">
            @TempData["FormSuccess"]
        </div>
    }

    @if (TempData["FormError"] is not null)
    {
        <div class="mb-6 rounded-xl border border-danger-line bg-danger/10 px-5 py-4 text-sm font-semibold text-danger">
            @TempData["FormError"]
        </div>
    }

    <div class="grid gap-8 lg:grid-cols-3">

        <!-- sol sütün-->
        <div class="space-y-6 lg:col-span-2">

            <!-- künye -->
            <div class="rounded-card border border-line bg-white p-6 shadow-soft">
                <dl class="grid gap-5 sm:grid-cols-2">
                    <div>
                        <dt class="text-xs font-bold uppercase tracking-wider text-muted">Kalkış Şehri</dt>
                        <dd class="mt-1 font-semibold text-navy">@t.StartCity.Get(culture)</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-bold uppercase tracking-wider text-muted">Ulaşım</dt>
                        <dd class="mt-1 font-semibold text-navy">@t.Transportation.Get(culture)</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-bold uppercase tracking-wider text-muted">Konaklama</dt>
                        <dd class="mt-1 font-semibold text-navy">@t.Accommodation.Get(culture)</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-bold uppercase tracking-wider text-muted">Rehber Dili</dt>
                        <dd class="mt-1 font-semibold text-navy">@t.GuideLanguage</dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(t.Route.Get(culture)))
                    {
                        <div class="sm:col-span-2">
                            <dt class="text-xs font-bold uppercase tracking-wider text-muted">Rota</dt>
                            <dd class="mt-1 font-semibold text-navy">@t.Route.Get(culture)</dd>
                        </div>
                    }
                </dl>

                @if (t.Amenities.Any())
                {
                    <div class="mt-6 flex flex-wrap gap-2 border-t border-line pt-5">
                        @foreach (var a in t.Amenities)
                        {
                            <span class="rounded-full border border-line bg-cream px-3.5 py-1.5 text-xs font-semibold text-navy">
                                @a.Name
                            </span>
                        }
                    </div>
                }
            </div>

            <!-- açıklama -->
            <div class="rounded-card border border-line bg-white p-6 shadow-soft">
                <h2 class="font-display text-xl font-bold text-navy">Tur Hakkında</h2>
                <p class="mt-3 leading-relaxed text-muted">@t.Description.Get(culture)</p>
            </div>

            <!-- Gün Gün Program -->
            @if (t.Itinerary.Any())
            {
                <div class="overflow-hidden rounded-card border border-line bg-white shadow-soft">
                    <div class="border-b border-line px-6 py-5">
                        <h2 class="font-display text-xl font-bold text-navy">Gün Gün Program</h2>
                        <p class="mt-1 text-sm text-muted">@t.Itinerary.Count günlük detaylı rota</p>
                    </div>

                    <div class="divide-y divide-line">
                        @foreach (var day in t.Itinerary.OrderBy(d => d.DayNumber))
                        {
                            <details class="group">
                                <summary class="flex cursor-pointer items-center gap-4 px-6 py-4 transition hover:bg-cream/40">
                                    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-teal/12 font-display text-sm font-bold text-teal-dark">
                                        @day.DayNumber
                                    </span>

                                    <div class="min-w-0 flex-1">
                                        <p class="font-semibold text-navy">@day.Title.Get(culture)</p>
                                        @if (day.City is not null)
                                        {
                                            <p class="text-xs text-muted">@day.City.Get(culture)</p>
                                        }
                                    </div>

                                    <svg class="h-5 w-5 shrink-0 text-muted transition group-open:rotate-180"
                                         viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="6 9 12 15 18 9" />
                                    </svg>
                                </summary>

                                <div class="px-6 pb-5 pl-20">
                                    <p class="leading-relaxed text-muted">@day.Description.Get(culture)</p>

                                    <div class="mt-3 flex flex-wrap gap-4 text-xs text-muted">
                                        @if (day.Transportation is not null && !string.IsNullOrWhiteSpace(day.Transportation.Get(culture)))
                                        {
                                            <span><b class="text-navy">Ulaşım:</b> @day.Transportation.Get(culture)</span>
                                        }
                                        @if (day.Accommodation is not null && !string.IsNullOrWhiteSpace(day.Accommodation.Get(culture)))
                                        {
                                            <span><b class="text-navy">Konaklama:</b> @day.Accommodation.Get(culture)</span>
                                        }
                                        @if (day.Meals is not null && !string.IsNullOrWhiteSpace(day.Meals.Get(culture)))
                                        {
                                            <span><b class="text-navy">Yemek:</b> @day.Meals.Get(culture)</span>
                                        }
                                    </div>
                                </div>
                            </details>
                        }
                    </div>
                </div>
            }


            <!-- dahil / Hariç -->
            @if (t.Included.Any() || t.Excluded.Any())
            {
                <div class="grid gap-6 sm:grid-cols-2">
                    @if (t.Included.Any())
                    {
                        <div class="rounded-card border border-line bg-white p-6 shadow-soft">
                            <h3 class="font-display text-lg font-bold text-navy">Fiyata Dahil</h3>
                            <ul class="mt-4 space-y-2.5">
                                @foreach (var item in t.Included)
                                {
                                    <li class="flex gap-2.5 text-sm text-muted">
                                        <span class="mt-0.5 shrink-0 font-bold text-teal">✓</span>
                                        @item.Get(culture)
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (t.Excluded.Any())
                    {
                        <div class="rounded-card border border-line bg-white p-6 shadow-soft">
                            <h3 class="font-display text-lg font-bold text-navy">Fiyata Dahil Değil</h3>
                            <ul class="mt-4 space-y-2.5">
                                @foreach (var item in t.Excluded)
                                {
                                    <li class="flex gap-2.5 text-sm text-muted">
                                        <span class="mt-0.5 shrink-0 font-bold text-danger">✕</span>
                                        @item.Get(culture)
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(t.VisaInfo.Get(culture)))
            {
                <div class="rounded-card border border-star/30 bg-star/5 p-6">
                    <h3 class="font-display text-base font-bold text-navy">Vize Bilgisi</h3>
                    <p class="mt-2 text-sm text-muted">@t.VisaInfo.Get(culture)</p>
                </div>
            }


            
            <!-- yorum formu -->
            <div class="mt-8 border-t border-line pt-6">
                @if (User.Identity!.IsAuthenticated)
                {
                    <h3 class="font-display text-lg font-bold text-navy">Değerlendirmeni Paylaş</h3>
                    <p class="mt-1 text-sm text-muted">Yorumun yönetici onayından sonra yayınlanır.</p>

                    <form asp-action="AddReview" method="post" class="mt-5 space-y-4">
                        <input type="hidden" name="seoUrl" value="@t.SeoUrl" />
                        <input type="hidden" name="tourId" value="@t.Id" />

                        <div>
                            <label class="mb-2 block text-xs font-bold uppercase tracking-wider text-muted">Puanın</label>
                            <div class="flex gap-1.5" id="starPicker">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <label class="cursor-pointer">
                                        <input type="radio" name="rating" value="@i" class="peer sr-only" required />
                                        <span class="grid h-11 w-11 place-items-center rounded-xl border border-line text-lg text-muted transition peer-checked:border-star peer-checked:bg-star/10 peer-checked:text-star hover:border-star">
                                            @i
                                        </span>
                                    </label>
                                }
                            </div>
                            <p class="mt-1.5 text-xs text-muted">1 = kötü · 5 = mükemmel</p>
                        </div>

                        <div>
                            <label class="mb-2 block text-xs font-bold uppercase tracking-wider text-muted">Yorumun</label>
                            <textarea name="comment" rows="4" required maxlength="1000"
                                  placeholder="Deneyimini anlat: rehber, konaklama, program akışı…"
                                  class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 text-sm text-navy placeholder:text-muted/70 focus:border-teal focus:bg-white focus:outline-none"></textarea>
                        </div>

                        <button type="submit"
                                class="rounded-full bg-teal px-6 py-3 font-semibold text-white transition hover:bg-teal-dark">
                            Değerlendirmeyi Gönder
                        </button>
                    </form>
                }
                else
                {
                    <div class="rounded-xl bg-cream/60 px-5 py-4 text-sm">
                        <span class="text-muted">Değerlendirme yazmak için</span>
                        <a asp-controller="Auth" asp-action="Login" class="font-semibold text-teal-dark hover:underline">giriş yap</a>
                        <span class="text-muted">ya da</span>
                        <a asp-controller="Auth" asp-action="Register" class="font-semibold text-teal-dark hover:underline">üye ol</a>.
                    </div>
                }
            </div>


            <!-- soru formu -->
            <div class="mt-8 border-t border-line pt-6">
                @if (User.Identity!.IsAuthenticated)
                {
                    <h3 class="font-display text-lg font-bold text-navy">Bir Sorun mu Var?</h3>
                    <p class="mt-1 text-sm text-muted">Ekibimiz yanıtlar, cevap bu sayfada görünür.</p>

                    <form asp-action="AddQuestion" method="post" class="mt-5 space-y-4">
                        <input type="hidden" name="seoUrl" value="@t.SeoUrl" />
                        <input type="hidden" name="tourId" value="@t.Id" />

                        <textarea name="text" rows="3" required maxlength="500"
                              placeholder="Örneğin: Tekerlekli sandalye kullanıyorum, program uygun mu?"
                              class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 text-sm text-navy placeholder:text-muted/70 focus:border-teal focus:bg-white focus:outline-none"></textarea>

                        <button type="submit"
                                class="rounded-full border border-navy px-6 py-3 font-semibold text-navy transition hover:bg-navy hover:text-white">
                            Soruyu Gönder
                        </button>
                    </form>
                }
                else
                {
                    <div class="rounded-xl bg-cream/60 px-5 py-4 text-sm">
                        <span class="text-muted">Soru sormak için</span>
                        <a asp-controller="Auth" asp-action="Login" class="font-semibold text-teal-dark hover:underline">giriş yap</a>.
                    </div>
                }
            </div>

        </div>

        <!--Sağ sütün: rezarvasyon -->
        <div class="lg:col-span-1">
            <div class="sticky top-6 space-y-4">

                <div class="rounded-card border border-line bg-white p-6 shadow-soft">
                    <p class="text-xs text-muted">Kişi başı</p>
                    <p class="font-display text-3xl font-extrabold text-navy">
                        @t.BasePrice.ToString("N0")
                        <span class="text-lg font-semibold text-muted">@t.CurrencyType</span>
                    </p>
                    <p class="mt-1 text-xs text-muted">
                        En az @t.MinParticipant katılımcı · en fazla @t.MaxCapacity kişi
                    </p>

                    <div class="mt-6 border-t border-line pt-5">
                        <p class="mb-3 text-xs font-bold uppercase tracking-wider text-muted">Kalkış Tarihleri</p>

                        @if (!openDates.Any())
                        {
                            <p class="rounded-xl bg-cream px-4 py-5 text-center text-sm text-muted">
                                Şu an satışta kalkış tarihi yok.
                            </p>
                        }
                        else
                        {
                            <div class="space-y-2.5">
                                @foreach (var d in openDates)
                                {
                                    <div class="rounded-xl border border-line p-4 transition hover:border-teal">
                                        <div class="flex items-start justify-between gap-3">
                                            <div>
                                                <p class="font-semibold text-navy">
                                                    @d.StartDate.ToString("dd.MM.yyyy") — @d.EndDate.ToString("dd.MM.yyyy")
                                                </p>
                                                <p class="mt-0.5 text-xs @(d.AvailableSeats <= 5 ? "font-semibold text-danger" : "text-muted")">
                                                    @d.AvailableSeats koltuk kaldı
                                                </p>
                                            </div>
                                            <p class="shrink-0 font-display font-bold text-navy">
                                                @d.Price.ToString("N0")
                                            </p>
                                        </div>

                                        <a asp-controller="Booking" asp-action="Create"
                                           asp-route-tourDateId="@d.Id"
                                           class="mt-3 block rounded-full bg-teal px-5 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-teal-dark">
                                            Rezervasyon Yap
                                        </a>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="rounded-card border border-line bg-cream/50 p-5 text-sm text-muted">
                    <p class="font-semibold text-navy">Yardıma mı ihtiyacın var?</p>
                    <p class="mt-1">Tur hakkındaki sorularını aşağıdaki bölümden sorabilirsin, ekibimiz yanıtlıyor.</p>
                </div>
            </div>
        </div>
    </div>
</div>
