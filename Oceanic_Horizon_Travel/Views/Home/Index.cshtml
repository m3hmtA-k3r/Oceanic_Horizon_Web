@{
    ViewData["Title"] = "Ana Sayfa";
}



<!-- HERO -->
<section class="relative flex min-h-[88vh] items-center bg-cover bg-center text-white"
         style="background-image: linear-gradient(180deg, rgba(14,42,59,.55) 0%, rgba(14,42,59,.35) 40%, rgba(14,42,59,.72) 100%), url('https://images.unsplash.com/photo-1502602898657-3e91760cbb34?auto=format&fit=crop&w=2000&q=80');">

    <div class="mx-auto w-full max-w-7xl px-4 py-24">

        <p class="mb-3 font-display text-xs font-bold uppercase tracking-[0.22em] text-teal-light">
            Oceanic Horizon ile keşfet
        </p>

        <h1 class="max-w-[14ch] font-display text-[clamp(2.4rem,5vw,4.1rem)] font-extrabold leading-[1.05] tracking-tight">
            Dünyayı Keşfetmeye Hazır Mısın?
        </h1>

        <p class="mt-5 max-w-[52ch] text-[clamp(1rem,1.4vw,1.22rem)] text-white/90">
            Avrupa'nın ikonik şehirlerinden Uzak Doğu'nun benzersiz rotalarına kadar unutulmaz deneyimler seni bekliyor.
        </p>

        <!-- ARAMA KUTUSU -->
        <div class="mt-10 max-w-[940px] rounded-[22px] bg-white/95 p-4 shadow-lift">
            <div class="grid grid-cols-1 items-center md:grid-cols-4">

                <div class="border-line px-4 py-2 md:border-r">
                    <label class="mb-0.5 block text-[0.7rem] font-bold uppercase tracking-[0.12em] text-muted">Destinasyon</label>
                    <input class="w-full bg-transparent font-semibold text-navy outline-none" placeholder="Nereye gidelim?" />
                </div>

                <div class="border-line px-4 py-2 md:border-r">
                    <label class="mb-0.5 block text-[0.7rem] font-bold uppercase tracking-[0.12em] text-muted">Tarih</label>
                    <input type="date" class="w-full bg-transparent font-semibold text-navy outline-none" />
                </div>

                <div class="px-4 py-2">
                    <label class="mb-0.5 block text-[0.7rem] font-bold uppercase tracking-[0.12em] text-muted">Kişi Sayısı</label>
                    <select class="w-full bg-transparent font-semibold text-navy outline-none">
                        <option>1 kişi</option>
                        <option selected>2 kişi</option>
                        <option>3 kişi</option>
                        <option>4 kişi</option>
                        <option>5+ kişi</option>
                    </select>
                </div>

                <div class="p-2">
                    <button class="w-full rounded-full bg-teal py-3.5 font-semibold text-white transition hover:bg-teal-dark">
                        Turları Ara
                    </button>
                </div>
            </div>
        </div>

        <!-- İSTATİSTİKLER -->
        <div class="mt-10 flex flex-wrap gap-10">
            <div>
                <b class="block font-display text-2xl font-bold leading-none">48+</b>
                <span class="text-sm text-white/80">Destinasyon</span>
            </div>
            <div>
                <b class="block font-display text-2xl font-bold leading-none">1.200+</b>
                <span class="text-sm text-white/80">Rehberli Tur</span>
            </div>
            <div>
                <b class="block font-display text-2xl font-bold leading-none">92.000</b>
                <span class="text-sm text-white/80">Mutlu Gezgin</span>
            </div>
        </div>
    </div>
</section>

