<!-- KONAKLAMA -->
<section id="konaklama" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4">

        <div class="mb-12 flex flex-wrap items-end justify-between gap-4">
            <div class="max-w-[640px]">
                <p class="font-display text-xs font-bold uppercase tracking-[0.22em] text-teal-dark">Ev sahiplerinden</p>
                <h2 class="mt-2 font-display text-[clamp(1.8rem,3vw,2.6rem)] font-bold tracking-tight text-navy">
                    Öne Çıkan Konaklamalar
                </h2>
                <p class="mt-2 text-muted">Villalar, evler ve butik oteller — doğrudan ev sahiplerinden.</p>
            </div>

            <a href="#" class="hidden rounded-full border border-line bg-white px-6 py-3 font-semibold text-navy transition hover:border-navy md:inline-block">
                Tüm konaklamalar
            </a>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var estate in estates)
            {
                <article class="group flex h-full flex-col overflow-hidden rounded-card border border-line bg-white shadow-soft transition duration-300 hover:-translate-y-1.5 hover:shadow-lift">

                    <div class="relative h-[215px] overflow-hidden">
                        <img src="https://picsum.photos/seed/@(estate.Img)/800/600"
                             alt="@estate.Name" loading="lazy"
                             class="h-full w-full object-cover transition duration-500 group-hover:scale-107" />

                        <span class="absolute left-3.5 top-3.5 rounded-full bg-white/95 px-3 py-1.5 text-xs font-semibold text-navy">
                            @estate.Type
                        </span>

                        <button type="button" aria-label="Favorilere ekle"
                                class="absolute right-3.5 top-3 grid h-9 w-9 place-items-center rounded-full bg-white/90 text-navy transition hover:scale-110 hover:text-teal-dark">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" />
                            </svg>
                        </button>
                    </div>

                    <div class="flex flex-1 flex-col px-5 pb-6 pt-5">
                        <span class="text-[0.78rem] font-semibold text-teal-dark">@estate.City</span>

                        <h3 class="mb-1 mt-1 font-display text-lg font-bold text-navy">@estate.Name</h3>

                        <p class="mb-3 text-[0.8rem] text-muted">Ev sahibi: @estate.Host</p>

                        <div class="mb-4 flex items-center gap-4 text-sm text-muted">
                            <span>👥 @estate.Capacity misafir</span>
                            <span class="font-semibold text-navy">
                                <span class="text-star">★</span> @estate.Rating
                                <span class="font-normal text-muted">(@estate.Reviews)</span>
                            </span>
                        </div>

                        <div class="mt-auto flex items-end justify-between border-t border-line pt-4">
                            <div>
                                <small class="block text-xs text-muted">Gecelik</small>
                                <b class="font-display text-xl text-navy">
                                    @estate.Price <span class="text-sm font-semibold text-muted">TL</span>
                                </b>
                            </div>

                            <button type="button" class="rounded-full bg-navy px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-dark">
                                İncele
                            </button>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>


