        new { Name = "Tarihi Taş Konak",      City = "Alaçatı, Türkiye",      Type = "Ev",    Capacity = 4, Rating = 4.8, Reviews = 142, Price = "2.900", Host = "Mehmet B.", Img = "alacati-konak" },
        new { Name = "Blue Palace Hotel",     City = "Bodrum, Türkiye",       Type = "Otel",  Capacity = 2, Rating = 4.7, Reviews = 315, Price = "3.200", Host = "Blue Palace", Img = "bodrum-hotel" }
