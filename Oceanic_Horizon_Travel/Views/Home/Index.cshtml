<!-- YORUMLAR -->
<section id="yorumlar" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4">

        <div class="mb-12 max-w-[640px]">
            <p class="font-display text-xs font-bold uppercase tracking-[0.22em] text-teal-dark">Gezgin yorumları</p>
            <h2 class="mt-2 font-display text-[clamp(1.8rem,3vw,2.6rem)] font-bold tracking-tight text-navy">
                Gezginler Ne Diyor?
            </h2>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            @foreach (var review in reviews)
            {
                <div class="h-full rounded-card border border-line bg-white p-7 shadow-soft">
                    <div class="mb-3 text-star">★★★★★</div>

                    <p class="leading-relaxed text-navy">@review.Comment</p>

                    <div class="mt-5 flex items-center gap-3">
                        <img src="https://images.unsplash.com/@(review.Img)?auto=format&fit=crop&w=200&q=80"
                             alt="@review.Name" class="h-11 w-11 rounded-full object-cover" />
                        <div>
                            <b class="block text-[0.95rem] text-navy">@review.Name</b>
                            <span class="text-[0.82rem] text-muted">@review.Tour</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- CTA -->
<section id="iletisim" class="py-20">
    <div class="mx-auto max-w-7xl px-4">

