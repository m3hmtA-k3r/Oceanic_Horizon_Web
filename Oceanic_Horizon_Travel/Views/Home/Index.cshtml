        new { Title = "Roma & Toskana",     Country = "İtalya",             Days = "6 gün", Rating = 4.8, Reviews = 1687, Price = "42.500", Badge = "Popüler",   Img = "photo-1552832230-c0197dd311b5" },
        new { Title = "Amsterdam Kanalları",Country = "Hollanda",           Days = "4 gün", Rating = 4.7, Reviews = 1203, Price = "29.900", Badge = "",          Img = "photo-1534351590666-13e3e96b5017" },
        new { Title = "Prag & Viyana",      Country = "Çekya · Avusturya",  Days = "6 gün", Rating = 4.8, Reviews = 1421, Price = "36.400", Badge = "",          Img = "photo-1541849546-216549ae216d" },
        new { Title = "Barselona",          Country = "İspanya",            Days = "5 gün", Rating = 4.9, Reviews = 1955, Price = "34.700", Badge = "Yeni",      Img = "photo-1583422409516-2895a77efded" },
        new { Title = "İsviçre Alpleri",    Country = "İsviçre",            Days = "7 gün", Rating = 5.0, Reviews = 842,  Price = "58.200", Badge = "Premium",   Img = "photo-1531366936337-7c912a4589a7" }
