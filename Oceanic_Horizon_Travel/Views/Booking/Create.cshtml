@model Oceanic_Horizon_Travel.DTOs.BookingDtos.BookingCreateViewModel

@{
    ViewData["Title"] = "Rezervasyon";
}

<div class="mx-auto max-w-6xl px-6 py-12">

    <div class="mb-8">
        <p class="font-display text-xs font-bold uppercase tracking-[0.22em] text-teal-dark">Rezervasyon</p>
        <h1 class="mt-2 font-display text-3xl font-bold tracking-tight text-navy">Katılımcı Bilgileri</h1>
        <p class="mt-1 text-muted">Kişi sayısını seç ve katılacak kişilerin bilgilerini gir.</p>
    </div>

    @if (TempData["Error"] is not null)
    {
        <div class="mb-6 rounded-xl border border-danger-line bg-danger/10 px-5 py-4 text-sm font-semibold text-danger">
            @TempData["Error"]
        </div>
    }

    <form asp-action="Create" method="post" class="grid gap-8 lg:grid-cols-3">

        <input type="hidden" asp-for="TourId" />
        <input type="hidden" asp-for="TourDateId" />

        <!--  SOL: FORM  -->
        <div class="space-y-6 lg:col-span-2">

            <!-- kişi sayısı -->
            <div class="rounded-card border border-line bg-white p-6 shadow-soft">
                <h2 class="font-display text-lg font-bold text-navy">Kaç Kişi?</h2>
                <p class="mt-1 text-xs text-muted">Bu kalkışta @Model.AvailableSeats koltuk kaldı.</p>

                <div class="mt-5 grid gap-5 sm:grid-cols-2">
                    <div>
                        <label class="mb-2 block text-xs font-bold uppercase tracking-wider text-muted">Yetişkin</label>
                        <input type="number" asp-for="AdultCount" id="adultCount" min="1" max="@Model.AvailableSeats"
                               class="w-full rounded-xl border border-line bg-cream/40 px-4 py-2.5 text-navy focus:border-teal focus:bg-white focus:outline-none" />
                        <p class="mt-1 text-xs text-muted">Tam ücret</p>
                    </div>

                    <div>
                        <label class="mb-2 block text-xs font-bold uppercase tracking-wider text-muted">Çocuk</label>
                        <input type="number" asp-for="ChildCount" id="childCount" min="0" max="@Model.AvailableSeats"
                               class="w-full rounded-xl border border-line bg-cream/40 px-4 py-2.5 text-navy focus:border-teal focus:bg-white focus:outline-none" />
                        <p class="mt-1 text-xs text-muted">%50 indirimli</p>
                    </div>
                </div>
            </div>

            <!-- katılımcılar -->
            <div class="rounded-card border border-line bg-white p-6 shadow-soft">
                <div class="flex items-center justify-between">
                    <h2 class="font-display text-lg font-bold text-navy">Katılımcılar</h2>
                    <span id="guestCountLabel" class="text-xs font-semibold text-muted"></span>
                </div>
                <p class="mt-1 text-xs text-muted">Kimlik bilgileri bilet ve sigorta için gerekli.</p>

                <div id="guestContainer" class="mt-5 space-y-4"></div>
            </div>
        </div>

        <!-- SAĞ: ÖZET  -->
        <div class="lg:col-span-1">
            <div class="sticky top-6 space-y-4">

                <div class="overflow-hidden rounded-card border border-line bg-white shadow-soft">
                    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                    {
                        <img src="@Model.ThumbnailUrl" alt="@Model.TourTitle" class="h-36 w-full object-cover" />
                    }

                    <div class="p-6">
                        <h3 class="font-display text-lg font-bold leading-snug text-navy">@Model.TourTitle</h3>
                        <p class="mt-1 text-sm text-muted">@Model.Day gün · @Model.Night gece</p>

                        <div class="mt-4 rounded-xl bg-cream/60 px-4 py-3 text-sm">
                            <p class="font-semibold text-navy">
                                @Model.StartDate.ToString("dd.MM.yyyy") — @Model.EndDate.ToString("dd.MM.yyyy")
                            </p>
                        </div>

                        <div class="mt-5 space-y-2.5 border-t border-line pt-5 text-sm">
                            <div class="flex justify-between">
                                <span class="text-muted">Kişi başı</span>
                                <span class="font-semibold text-navy">@Model.Price.ToString("N0") @Model.CurrencyType</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-muted">Yetişkin</span>
                                <span id="adultLine" class="font-semibold text-navy">—</span>
                            </div>
                            <div id="childRow" class="flex justify-between">
                                <span class="text-muted">Çocuk (%50)</span>
                                <span id="childLine" class="font-semibold text-navy">—</span>
                            </div>
                        </div>

                        <div class="mt-4 flex items-end justify-between border-t border-line pt-4">
                            <span class="text-sm font-semibold text-navy">Toplam</span>
                            <span id="totalLine" class="font-display text-2xl font-extrabold text-navy">—</span>
                        </div>

                        <button type="submit"
                                class="mt-5 w-full rounded-full bg-teal px-6 py-3.5 font-semibold text-white transition hover:bg-teal-dark">
                            Rezervasyonu Tamamla
                        </button>

                        <p class="mt-3 text-center text-xs text-muted">
                            Ödeme rezervasyon onaylandıktan sonra alınır.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const price = @Model.Price;
        const currency = '@Model.CurrencyType';
        const maxSeats = @Model.AvailableSeats;

        const adultInput = document.getElementById('adultCount');
        const childInput = document.getElementById('childCount');
        const container = document.getElementById('guestContainer');

        // Sunucudan gelen mevcut misafirler (hata sonrası formu doldurmak için)
        const existingGuests = @Html.Raw(Json.Serialize(Model.Guests));

        function money(value) {
            return value.toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
        }

        function guestRow(index, label, data) {
            const g = data || {};
            return `
            <div class="rounded-xl border border-line p-4">
                <p class="mb-3 text-xs font-bold uppercase tracking-wider text-teal-dark">${label}</p>
                <div class="grid gap-3 sm:grid-cols-2">
                    <input name="Guests[${index}].FirstName" value="${g.firstName || ''}" required placeholder="Ad"
                           class="rounded-xl border border-line bg-cream/40 px-4 py-2.5 text-sm text-navy focus:border-teal focus:bg-white focus:outline-none" />
                    <input name="Guests[${index}].LastName" value="${g.lastName || ''}" required placeholder="Soyad"
                           class="rounded-xl border border-line bg-cream/40 px-4 py-2.5 text-sm text-navy focus:border-teal focus:bg-white focus:outline-none" />
                    <input name="Guests[${index}].IdentityNumber" value="${g.identityNumber || ''}" required placeholder="Kimlik / Pasaport No"
                           class="rounded-xl border border-line bg-cream/40 px-4 py-2.5 text-sm text-navy focus:border-teal focus:bg-white focus:outline-none" />
                    <input name="Guests[${index}].BirthDate" type="date" value="${(g.birthDate || '').substring(0, 10)}" required
                           class="rounded-xl border border-line bg-cream/40 px-4 py-2.5 text-sm text-navy focus:border-teal focus:bg-white focus:outline-none" />
                </div>
            </div>`;
        }

        function render() {
            let adults = parseInt(adultInput.value) || 0;
            let children = parseInt(childInput.value) || 0;

            if (adults < 1) { adults = 1; adultInput.value = 1; }
            if (children < 0) { children = 0; childInput.value = 0; }

            // Kontenjanı aşma
            if (adults + children > maxSeats) {
                children = Math.max(0, maxSeats - adults);
                childInput.value = children;
            }

            // Katılımcı alanları
            let html = '';
            let index = 0;

            for (let i = 0; i < adults; i++) {
                html += guestRow(index, `${i + 1}. Yetişkin`, existingGuests[index]);
                index++;
            }
            for (let i = 0; i < children; i++) {
                html += guestRow(index, `${i + 1}. Çocuk`, existingGuests[index]);
                index++;
            }

            container.innerHTML = html;
            document.getElementById('guestCountLabel').textContent = `${adults + children} kişi`;

            // Fiyat özeti
            const adultTotal = adults * price;
            const childTotal = children * price * 0.5;

            document.getElementById('adultLine').textContent = `${adults} × ${money(price)} = ${money(adultTotal)}`;
            document.getElementById('childLine').textContent = `${children} × ${money(price * 0.5)} = ${money(childTotal)}`;
            document.getElementById('childRow').style.display = children > 0 ? 'flex' : 'none';
            document.getElementById('totalLine').textContent = `${money(adultTotal + childTotal)} ${currency}`;
        }

        adultInput.addEventListener('input', render);
        childInput.addEventListener('input', render);
        render();
    </script>
}
