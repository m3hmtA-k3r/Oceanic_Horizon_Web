@using System.Globalization
@model List<Oceanic_Horizon_Travel.DTOs.CategoryDtos.ResultCategoryDto>

@{
    ViewData["Title"] = "Categories";
    var culture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}

<div>

    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="font-display text-xs font-bold uppercase tracking-[0.22em] text-teal-dark">Katalog</p>
            <h1 class="mt-2 font-display text-3xl font-bold tracking-tight text-navy">Kategoriler</h1>
            <p class="mt-1 text-muted">Turların gruplandığı kategorileri buradan yönet.</p>
        </div>

        <a asp-action="Create"
           class="rounded-full bg-teal px-6 py-3 font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-teal-dark">
            Yeni Kategori
        </a>
    </div>

    <div class="overflow-hidden rounded-card border border-line bg-white shadow-soft">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="border-b border-line bg-cream/50">
                    <tr>
                        <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-muted">Kategori</th>
                        <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-muted">SEO Adresi</th>
                        <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-muted">İkon</th>
                        <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-muted">Çeviriler</th>
                        <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-muted">Durum</th>
                        <th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-wider text-muted">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model is null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-muted">
                                Henüz kategori eklenmemiş.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var category in Model)
                        {
                            <tr class="border-b border-line last:border-0 hover:bg-cream/30">

                                <td class="px-6 py-4 font-semibold text-navy">
                                    @category.Name.Get(culture)
                                </td>

                                <td class="px-6 py-4 text-sm text-teal-dark">
                                    /@category.SeoUrl
                                </td>

                                <td class="px-6 py-4 text-sm text-muted">
                                    @(string.IsNullOrWhiteSpace(category.Icon) ? "—" : category.Icon)
                                </td>

                                <td class="px-6 py-4">
                                    <div class="flex gap-1">
                                        <span class="rounded px-1.5 py-0.5 text-[0.65rem] font-bold @(string.IsNullOrWhiteSpace(category.Name.Tr) ? "bg-line text-muted" : "bg-teal/12 text-teal-dark")">TR</span>
                                        <span class="rounded px-1.5 py-0.5 text-[0.65rem] font-bold @(string.IsNullOrWhiteSpace(category.Name.En) ? "bg-line text-muted" : "bg-teal/12 text-teal-dark")">EN</span>
                                        <span class="rounded px-1.5 py-0.5 text-[0.65rem] font-bold @(string.IsNullOrWhiteSpace(category.Name.Pt) ? "bg-line text-muted" : "bg-teal/12 text-teal-dark")">PT</span>
                                    </div>
                                </td>

                                <td class="px-6 py-4">
                                    @if (category.IsActive)
                                    {
                                        <span class="rounded-full bg-teal/12 px-3 py-1 text-xs font-semibold text-teal-dark">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="rounded-full bg-line px-3 py-1 text-xs font-semibold text-muted">Pasif</span>
                                    }
                                </td>

                                <td class="px-6 py-4">
                                    <div class="flex justify-end gap-2">
                                        <a asp-action="Update" asp-route-id="@category.Id"
                                           class="rounded-full border border-line px-4 py-2 text-sm font-semibold text-navy transition hover:border-navy">
                                            Düzenle
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@category.Id"
                                           onclick="return confirm('Bu kategori silinecek, emin misin?')"
                                           class="rounded-full border border-line px-4 py-2 text-sm font-semibold text-red-600 transition hover:border-red-600">
                                            Sil
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
