@model Oceanic_Horizon_Travel.DTOs.SiteSettingsDtos.UpdateSiteSettingsDto

@{
    ViewData["Title"] = "Site Yönetimi";
}

<div class="max-w-4xl">

    <div class="mb-8">
        <p class="font-display text-xs font-bold uppercase tracking-[0.22em] text-teal-dark">Katalog</p>
        <h1 class="mt-2 font-display text-3xl font-bold tracking-tight text-navy">Site Yönetimi</h1>
        <p class="mt-1 text-muted">Firma bilgileri, iletişim ve kurumsal metinler.</p>
    </div>

    @if (TempData["Success"] is not null)
    {
        <div class="mb-6 rounded-xl border border-teal/30 bg-teal/10 px-5 py-4 text-sm font-semibold text-teal-dark">
            @TempData["Success"]
        </div>
    }

    <div class="rounded-card border border-line bg-white p-8 shadow-soft">

        <div asp-validation-summary="All" class="mb-5 text-sm text-red-600"></div>

        <form asp-action="Index" method="post" enctype="multipart/form-data" class="space-y-6">

            <input asp-for="Id" type="hidden" />
            <input asp-for="LogoUrl" type="hidden" />


            <div>
                <label asp-for="CompanyName" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Firma Adı</label>
                <input asp-for="CompanyName" placeholder="Oceanic Horizon Travel"
                       class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:bg-white focus:outline-none transition" />
            </div>

            <div>
                <label asp-for="LogoFile" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Logo</label>
                <input asp-for="LogoFile" type="file" accept="image/*"
                       class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 text-sm text-navy file:mr-4 file:rounded-full file:border-0 file:bg-teal file:px-5 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-teal-dark focus:border-teal focus:bg-white focus:outline-none transition" />
                <p class="mt-1.5 text-xs text-muted">Boş bırakırsan mevcut logo korunur.</p>
            </div>

            @if (!string.IsNullOrEmpty(Model?.LogoUrl))
            {
                <div>
                    <p class="mb-2 text-xs font-bold uppercase tracking-wider text-muted">Mevcut Logo</p>
                    <img src="@Model.LogoUrl" alt="Logo" class="h-16 rounded-lg bg-cream/50 object-contain p-2" />
                </div>
            }


            <div class="rounded-xl border border-line bg-cream/30 p-5">
                <p class="mb-4 text-xs font-bold uppercase tracking-wider text-teal-dark">İletişim</p>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <label asp-for="Phone" class="mb-1 block text-xs font-semibold text-muted">Telefon</label>
                        <input asp-for="Phone" placeholder="+90 216 000 00 00"
                               class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                    </div>

                    <div>
                        <label asp-for="Email" class="mb-1 block text-xs font-semibold text-muted">E-posta</label>
                        <input asp-for="Email" type="email" placeholder="info@oceanichorizon.com"
                               class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                    </div>
                </div>

                <div class="mt-4">
                    <label asp-for="Address" class="mb-1 block text-xs font-semibold text-muted">Adres</label>
                    <input asp-for="Address" placeholder="Bağdat Caddesi No:1, Kadıköy / İstanbul"
                           class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                </div>
            </div>


            <div class="rounded-xl border border-line bg-cream/30 p-5">
                <p class="mb-3 text-xs font-bold uppercase tracking-wider text-teal-dark">Hakkımızda</p>

                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-muted">Türkçe</label>
                        <textarea asp-for="About.Tr" rows="5"
                                  class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition"></textarea>
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-muted">English</label>
                        <textarea asp-for="About.En" rows="5"
                                  class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition"></textarea>
                    </div>
                </div>

                <details class="group mt-3">
                    <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-xs font-semibold text-teal-dark hover:underline">
                        <span class="transition group-open:rotate-90">▸</span> Português (isteğe bağlı)
                    </summary>
                    <div class="mt-3">
                        <textarea asp-for="About.Pt" rows="5"
                                  class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition"></textarea>
                    </div>
                </details>
            </div>


            <details class="group rounded-xl border border-line bg-cream/30 p-5">
                <summary class="cursor-pointer list-none">
                    <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-teal-dark">
                        <span class="transition group-open:rotate-90">▸</span>
                        Misyon & Vizyon
                        <span class="font-normal normal-case text-muted">— isteğe bağlı</span>
                    </span>
                </summary>

                <div class="mt-5 space-y-5">
                    <div>
                        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted">Misyon</p>
                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                            <textarea asp-for="Mission.Tr" rows="3" placeholder="Türkçe"
                                      class="w-full rounded-xl border border-line bg-white px-4 py-3 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition"></textarea>
                            <textarea asp-for="Mission.En" rows="3" placeholder="English"
                                      class="w-full rounded-xl border border-line bg-white px-4 py-3 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition"></textarea>
                            <textarea asp-for="Mission.Pt" rows="3" placeholder="Português"
                                      class="w-full rounded-xl border border-line bg-white px-4 py-3 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition"></textarea>
                        </div>
                    </div>

                    <div>
                        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted">Vizyon</p>
                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                            <textarea asp-for="Vision.Tr" rows="3" placeholder="Türkçe"
                                      class="w-full rounded-xl border border-line bg-white px-4 py-3 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition"></textarea>
                            <textarea asp-for="Vision.En" rows="3" placeholder="English"
                                      class="w-full rounded-xl border border-line bg-white px-4 py-3 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition"></textarea>
                            <textarea asp-for="Vision.Pt" rows="3" placeholder="Português"
                                      class="w-full rounded-xl border border-line bg-white px-4 py-3 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition"></textarea>
                        </div>
                    </div>
                </div>
            </details>


            <div class="rounded-xl border border-line bg-cream/30 p-5">
                <p class="mb-4 text-xs font-bold uppercase tracking-wider text-teal-dark">Sosyal Medya</p>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <label asp-for="Instagram" class="mb-1 block text-xs font-semibold text-muted">Instagram</label>
                        <input asp-for="Instagram" placeholder="https://instagram.com/..."
                               class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                    </div>

                    <div>
                        <label asp-for="Facebook" class="mb-1 block text-xs font-semibold text-muted">Facebook</label>
                        <input asp-for="Facebook" placeholder="https://facebook.com/..."
                               class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                    </div>

                    <div>
                        <label asp-for="Youtube" class="mb-1 block text-xs font-semibold text-muted">Youtube</label>
                        <input asp-for="Youtube" placeholder="https://youtube.com/..."
                               class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                    </div>

                    <div>
                        <label asp-for="LinkedIn" class="mb-1 block text-xs font-semibold text-muted">LinkedIn</label>
                        <input asp-for="LinkedIn" placeholder="https://linkedin.com/company/..."
                               class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                    </div>
                </div>
            </div>

            <div class="border-t border-line pt-5">
                <button type="submit" class="rounded-full bg-teal px-7 py-3 font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-teal-dark">
                    Kaydet
                </button>
            </div>
        </form>
    </div>
</div>
