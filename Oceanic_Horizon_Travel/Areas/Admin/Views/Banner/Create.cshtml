@model Oceanic_Horizon_Travel.DTOs.BannerDtos.CreateBannerDto

@{
    ViewData["Title"] = "Yeni Banner";
}

<div class="max-w-3xl">

    <div class="mb-8">
        <p class="font-display text-xs font-bold uppercase tracking-[0.22em] text-teal-dark">Yönetim · Banner</p>
        <h1 class="mt-2 font-display text-3xl font-bold tracking-tight text-navy">Yeni Banner</h1>
        <p class="mt-1 text-muted">Ana sayfada gösterilecek görseli ekle.</p>
    </div>

    <div class="rounded-card border border-line bg-white p-8 shadow-soft">

        <div asp-validation-summary="All" class="mb-5 text-sm text-red-600"></div>

        <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-6">

            <!-- BAŞLIK -->
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div>
                    <label class="mb-1 block text-xs font-semibold text-muted">Türkçe</label>
                    <input asp-for="Title.Tr" placeholder="Dünyayı Keşfetmeye Hazır Mısın?"
                           class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                </div>

                <div>
                    <label class="mb-1 block text-xs font-semibold text-muted">English</label>
                    <input asp-for="Title.En" placeholder="Ready to Explore the World?"
                           class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                </div>
            </div>

            <details class="group mt-3">
                <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-xs font-semibold text-teal-dark hover:underline">
                    <span class="transition group-open:rotate-90">▸</span>
                    Português (isteğe bağlı)
                </summary>

                <div class="mt-3">
                    <input asp-for="Title.Pt" placeholder="Pronto para Explorar o Mundo?"
                           class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                </div>
            </details>


            <!-- AÇIKLAMA -->
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div>
                    <label class="mb-1 block text-xs font-semibold text-muted">Türkçe</label>
                    <textarea asp-for="Description.Tr" rows="3"
                              class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition"></textarea>
                </div>

                <div>
                    <label class="mb-1 block text-xs font-semibold text-muted">English</label>
                    <textarea asp-for="Description.En" rows="3"
                              class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition"></textarea>
                </div>
            </div>

            <details class="group mt-3">
                <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-xs font-semibold text-teal-dark hover:underline">
                    <span class="transition group-open:rotate-90">▸</span>
                    Português (isteğe bağlı)
                </summary>

                <div class="mt-3">
                    <textarea asp-for="Description.Pt" rows="3"
                              class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition"></textarea>
                </div>
            </details>



            <!-- GÖRSEL -->
            <div>
                <label asp-for="ImageFile" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Görsel</label>
                <input asp-for="ImageFile" type="file" accept="image/*"
                       class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 text-sm text-navy file:mr-4 file:rounded-full file:border-0 file:bg-teal file:px-5 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-teal-dark focus:border-teal focus:bg-white focus:outline-none transition" />
            </div>

            <label class="flex cursor-pointer items-center gap-3">
                <input asp-for="IsActive" type="checkbox" class="h-5 w-5 rounded border-line text-teal focus:ring-teal" />
                <span class="text-sm font-medium text-navy">Yayında olsun</span>
            </label>

            <div class="flex gap-3 border-t border-line pt-5">
                <button type="submit" class="rounded-full bg-teal px-7 py-3 font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-teal-dark">
                    Kaydet
                </button>
                <a asp-action="Index" class="rounded-full border border-line px-6 py-3 font-semibold text-navy transition hover:border-navy">
                    İptal
                </a>
            </div>
        </form>

    </div>
</div>
