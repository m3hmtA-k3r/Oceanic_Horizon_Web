@using System.Globalization
@model List<Oceanic_Horizon_Travel.DTOs.BannerDtos.ResultBannerDto>

@{
    ViewData["Title"] = "Bannerlar";
    var culture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}


@{
    ViewData["Title"] = "Bannerlar";
}


<div class="mx-auto max-w-7xl px-4 py-12">

    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="font-display text-xs font-bold uppercase tracking-[0.22em] text-teal-dark">Yönetim</p>
            <h1 class="mt-2 font-display text-3xl font-bold tracking-tight text-navy">Bannerlar</h1>
            <p class="mt-1 text-muted">Ana sayfada gösterilecek görselleri buradan yönet.</p>
        </div>

        <a asp-action="Create"
           class="rounded-full bg-teal px-6 py-3 font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-teal-dark">
            Yeni Banner
        </a>
    </div>

    <div class="overflow-hidden rounded-card border border-line bg-white shadow-soft">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="border-b border-line bg-cream/50">
                    <tr>
                        <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-muted">Görsel</th>
                        <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-muted">Başlık</th>
                        <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-muted">Açıklama</th>
                        <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-muted">Durum</th>
                        <th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-wider text-muted">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model is null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-muted">
                                Henüz banner eklenmemiş.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var banner in Model)
                        {
                            <tr class="border-b border-line last:border-0 hover:bg-cream/30">
                                <td class="px-6 py-4">
                                    <img src="@banner.ImageUrl" alt="@banner.Title"
                                         class="h-14 w-24 rounded-lg object-cover" />
                                </td>

                                <td class="px-6 py-4 font-semibold text-navy">@banner.Title.Get(culture)</td>

                                <td class="max-w-xs px-6 py-4 text-sm text-muted">@banner.Description.Get(culture)</td>


                                <td class="px-6 py-4">
                                    @if (banner.IsActive)
                                    {
                                        <span class="rounded-full bg-teal/12 px-3 py-1 text-xs font-semibold text-teal-dark">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="rounded-full bg-line px-3 py-1 text-xs font-semibold text-muted">Pasif</span>
                                    }
                                </td>

                                <td class="px-6 py-4">
                                    <div class="flex justify-end gap-2">
                                        <a asp-action="Update" asp-route-id="@banner.Id"
                                           class="rounded-full border border-line px-4 py-2 text-sm font-semibold text-navy transition hover:border-navy">
                                            Düzenle
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@banner.Id"
                                           onclick="return confirm('Bu banner silinecek, emin misin?')"
                                           class="rounded-full border border-line px-4 py-2 text-sm font-semibold text-red-600 transition hover:border-red-600">
                                            Sil
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
