@model Oceanic_Horizon_Travel.DTOs.DestinationDtos.CreateDestinationDto

@{
    ViewData["Title"] = "Destinasyon Create";
}

<div class="max-w-3xl">

    <div class="mb-8">
        <p class="font-display text-xs font-bold uppercase tracking-[0.22em] text-teal-dark">Katalog · Destinasyon</p>
        <h1 class="mt-2 font-display text-3xl font-bold tracking-tight text-navy">Yeni Destinasyon</h1>
        <p class="mt-1 text-muted">Turların ve konaklamaların bağlanacağı şehri ekle.</p>
    </div>

    <div class="rounded-card border border-line bg-white p-8 shadow-soft">

        <div asp-validation-summary="All" class="mb-5 text-sm text-red-600"></div>

        <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-6">

            <!-- KONUM -->
            <div class="rounded-xl border border-line bg-cream/30 p-5">
                <p class="mb-3 text-xs font-bold uppercase tracking-wider text-teal-dark">Konum</p>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-muted">Şehir — Türkçe</label>
                        <input asp-for="City.Tr" placeholder="Kapadokya"
                               class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                    </div>

                    <div>
                        <label class="mb-1 block text-xs font-semibold text-muted">Ülke — Türkçe</label>
                        <input asp-for="Country.Tr" placeholder="Türkiye"
                               class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                    </div>
                </div>

                <details class="group mt-3">
                    <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-xs font-semibold text-teal-dark hover:underline">
                        <span class="transition group-open:rotate-90">▸</span>
                        Diğer diller (isteğe bağlı)
                    </summary>

                    <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div>
                            <label class="mb-1 block text-xs font-semibold text-muted">Şehir — English</label>
                            <input asp-for="City.En" placeholder="Cappadocia"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                        </div>

                        <div>
                            <label class="mb-1 block text-xs font-semibold text-muted">Ülke — English</label>
                            <input asp-for="Country.En" placeholder="Türkiye"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                        </div>

                        <div>
                            <label class="mb-1 block text-xs font-semibold text-muted">Şehir — Português</label>
                            <input asp-for="City.Pt" placeholder="Capadócia"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                        </div>

                        <div>
                            <label class="mb-1 block text-xs font-semibold text-muted">Ülke — Português</label>
                            <input asp-for="Country.Pt" placeholder="Turquia"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                        </div>
                    </div>
                </details>
            </div>

            <!-- SEO ADRESİ -->
            <div>
                <label asp-for="SeoUrl" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">SEO Adresi</label>
                <input asp-for="SeoUrl" placeholder="kapadokya-goreme"
                       class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:bg-white focus:outline-none transition" />
                <p class="mt-1.5 text-xs text-muted">Tüm dillerde aynı adres kullanılır. Sadece küçük harf, rakam ve tire.</p>
            </div>

            <!-- KISA AÇIKLAMA -->
            <div class="rounded-xl border border-line bg-cream/30 p-5">
                <p class="mb-3 text-xs font-bold uppercase tracking-wider text-teal-dark">Kısa Açıklama</p>

                <div>
                    <label class="mb-1 block text-xs font-semibold text-muted">Türkçe</label>
                    <textarea asp-for="ShortDescription.Tr" rows="2" placeholder="Peribacaları ve balon turlarıyla ünlü eşsiz coğrafya."
                              class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition"></textarea>
                </div>

                <details class="group mt-3">
                    <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-xs font-semibold text-teal-dark hover:underline">
                        <span class="transition group-open:rotate-90">▸</span>
                        Diğer diller (isteğe bağlı)
                    </summary>

                    <div class="mt-3 space-y-3">
                        <div>
                            <label class="mb-1 block text-xs font-semibold text-muted">English</label>
                            <textarea asp-for="ShortDescription.En" rows="2"
                                      class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition"></textarea>
                        </div>

                        <div>
                            <label class="mb-1 block text-xs font-semibold text-muted">Português</label>
                            <textarea asp-for="ShortDescription.Pt" rows="2"
                                      class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition"></textarea>
                        </div>
                    </div>
                </details>
            </div>

            <!-- AÇIKLAMA -->
            <div class="rounded-xl border border-line bg-cream/30 p-5">
                <p class="mb-3 text-xs font-bold uppercase tracking-wider text-teal-dark">Açıklama</p>

                <div>
                    <label class="mb-1 block text-xs font-semibold text-muted">Türkçe</label>
                    <textarea asp-for="Description.Tr" rows="6" placeholder="Detay sayfasında görünecek uzun tanıtım metni..."
                              class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition"></textarea>
                </div>

                <details class="group mt-3">
                    <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-xs font-semibold text-teal-dark hover:underline">
                        <span class="transition group-open:rotate-90">▸</span>
                        Diğer diller (isteğe bağlı)
                    </summary>

                    <div class="mt-3 space-y-3">
                        <div>
                            <label class="mb-1 block text-xs font-semibold text-muted">English</label>
                            <textarea asp-for="Description.En" rows="6"
                                      class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition"></textarea>
                        </div>

                        <div>
                            <label class="mb-1 block text-xs font-semibold text-muted">Português</label>
                            <textarea asp-for="Description.Pt" rows="6"
                                      class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition"></textarea>
                        </div>
                    </div>
                </details>
            </div>

            <!-- GÖRSEL -->
            <div>
                <label asp-for="ImageFile" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Kapak Görseli</label>
                <input asp-for="ImageFile" type="file" accept="image/*"
                       class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 text-sm text-navy file:mr-4 file:rounded-full file:border-0 file:bg-teal file:px-5 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-teal-dark focus:border-teal focus:bg-white focus:outline-none transition" />
            </div>

            <div class="space-y-3 border-t border-line pt-5">
                <label class="flex cursor-pointer items-center gap-3">
                    <input asp-for="IsActive" type="checkbox" class="h-5 w-5 rounded border-line text-teal focus:ring-teal" />
                    <span class="text-sm font-medium text-navy">Yayında olsun</span>
                </label>

                <label class="flex cursor-pointer items-center gap-3">
                    <input asp-for="IsFeatured" type="checkbox" class="h-5 w-5 rounded border-line text-teal focus:ring-teal" />
                    <span class="text-sm font-medium text-navy">Ana sayfada öne çıkar</span>
                </label>
            </div>

            <div class="flex gap-3 border-t border-line pt-5">
                <button type="submit" class="rounded-full bg-teal px-7 py-3 font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-teal-dark">
                    Kaydet
                </button>
                <a asp-action="Index" class="rounded-full border border-line px-6 py-3 font-semibold text-navy transition hover:border-navy">
                    İptal
                </a>
            </div>
        </form>

    </div>
</div>
