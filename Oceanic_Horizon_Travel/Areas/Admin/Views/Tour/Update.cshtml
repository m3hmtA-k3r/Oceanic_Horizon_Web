@model Oceanic_Horizon_Travel.DTOs.TourDtos.UpdateTourDto

@{
    ViewData["Title"] = "Tur Update";
}

<div class="max-w-4xl">

    <div class="mb-8">
        <p class="font-display text-xs font-bold uppercase tracking-[0.22em] text-teal-dark">Yönetim · Tur</p>
        <h1 class="mt-2 font-display text-3xl font-bold tracking-tight text-navy">Tur Update</h1>
        <p class="mt-1 text-muted">@Model?.Title?.Tr</p>
    </div>

    <div class="rounded-card border border-line bg-white p-8 shadow-soft">

        <div asp-validation-summary="All" class="mb-5 text-sm text-red-600"></div>

        <form asp-action="Update" method="post" enctype="multipart/form-data" class="space-y-6">


            <input asp-for="Id" type="hidden" />
            <input asp-for="ThumbnailUrl" type="hidden" />
            <input asp-for="Rating" type="hidden" />
            <input asp-for="ReviewCount" type="hidden" />

          

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="DestinationId" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Destinasyon</label>
                    <select asp-for="DestinationId" asp-items="@ViewBag.Destinations"
                            class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 font-medium text-navy focus:border-teal focus:bg-white focus:outline-none transition">
                        <option value="">Destinasyon seçin</option>
                    </select>
                </div>

                <div>
                    <label asp-for="CategoryId" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Kategori</label>
                    <select asp-for="CategoryId" asp-items="@ViewBag.Categories"
                            class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 font-medium text-navy focus:border-teal focus:bg-white focus:outline-none transition">
                        <option value="">Kategori seçin</option>
                    </select>
                </div>
            </div>


            <div class="rounded-xl border border-line bg-cream/30 p-5">
                <p class="mb-3 text-xs font-bold uppercase tracking-wider text-teal-dark">Tur Adı</p>

                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-muted">Türkçe</label>
                        <input asp-for="Title.Tr"
                               class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition" />
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-muted">English</label>
                        <input asp-for="Title.En"
                               class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition" />
                    </div>
                </div>

                <details class="group mt-3">
                    <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-xs font-semibold text-teal-dark hover:underline">
                        <span class="transition group-open:rotate-90">▸</span> Português (isteğe bağlı)
                    </summary>
                    <div class="mt-3">
                        <input asp-for="Title.Pt"
                               class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition" />
                    </div>
                </details>
            </div>


            <div>
                <label asp-for="SeoUrl" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">SEO Adresi</label>
                <input asp-for="SeoUrl"
                       class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 font-medium text-navy focus:border-teal focus:bg-white focus:outline-none transition" />
                <p class="mt-1.5 text-xs text-muted">Değiştirirsen eski bağlantılar kırılır — dikkatli ol.</p>
            </div>


            <div class="rounded-xl border border-line bg-cream/30 p-5">
                <p class="mb-3 text-xs font-bold uppercase tracking-wider text-teal-dark">Kısa Açıklama</p>

                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-muted">Türkçe</label>
                        <textarea asp-for="ShortDescription.Tr" rows="2"
                                  class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition"></textarea>
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-muted">English</label>
                        <textarea asp-for="ShortDescription.En" rows="2"
                                  class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition"></textarea>
                    </div>
                </div>

                <details class="group mt-3">
                    <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-xs font-semibold text-teal-dark hover:underline">
                        <span class="transition group-open:rotate-90">▸</span> Português (isteğe bağlı)
                    </summary>
                    <div class="mt-3">
                        <textarea asp-for="ShortDescription.Pt" rows="2"
                                  class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition"></textarea>
                    </div>
                </details>
            </div>


            <div class="rounded-xl border border-line bg-cream/30 p-5">
                <p class="mb-3 text-xs font-bold uppercase tracking-wider text-teal-dark">Tur Açıklaması</p>

                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-muted">Türkçe</label>
                        <textarea asp-for="Description.Tr" rows="6"
                                  class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition"></textarea>
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-muted">English</label>
                        <textarea asp-for="Description.En" rows="6"
                                  class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition"></textarea>
                    </div>
                </div>

                <details class="group mt-3">
                    <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-xs font-semibold text-teal-dark hover:underline">
                        <span class="transition group-open:rotate-90">▸</span> Português (isteğe bağlı)
                    </summary>
                    <div class="mt-3">
                        <textarea asp-for="Description.Pt" rows="6"
                                  class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition"></textarea>
                    </div>
                </details>
            </div>


            <div class="rounded-xl border border-line bg-cream/30 p-5">
                <p class="mb-3 text-xs font-bold uppercase tracking-wider text-teal-dark">Tur Rotası <span class="font-normal normal-case text-muted">(isteğe bağlı)</span></p>

                <div>
                    <label class="mb-1 block text-xs font-semibold text-muted">Türkçe</label>
                    <input asp-for="Route.Tr"
                           class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition" />
                </div>

                <details class="group mt-3">
                    <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-xs font-semibold text-teal-dark hover:underline">
                        <span class="transition group-open:rotate-90">▸</span> Diğer diller
                    </summary>
                    <div class="mt-3 space-y-3">
                        <input asp-for="Route.En"
                               class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition" />
                        <input asp-for="Route.Pt"
                               class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition" />
                    </div>
                </details>
            </div>


            <div class="grid grid-cols-2 gap-5 sm:grid-cols-4">
                <div>
                    <label asp-for="Day" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Gün</label>
                    <input asp-for="Day" type="number" min="1" max="60"
                           class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 font-medium text-navy focus:border-teal focus:bg-white focus:outline-none transition" />
                </div>
                <div>
                    <label asp-for="Night" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Gece</label>
                    <input asp-for="Night" type="number" min="0" max="60"
                           class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 font-medium text-navy focus:border-teal focus:bg-white focus:outline-none transition" />
                </div>
                <div>
                    <label asp-for="MaxCapacity" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Maks. Kontenjan</label>
                    <input asp-for="MaxCapacity" type="number" min="1" max="500"
                           class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 font-medium text-navy focus:border-teal focus:bg-white focus:outline-none transition" />
                </div>
                <div>
                    <label asp-for="MinParticipant" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Min. Katılımcı</label>
                    <input asp-for="MinParticipant" type="number" min="0"
                           class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 font-medium text-navy focus:border-teal focus:bg-white focus:outline-none transition" />
                </div>
            </div>

          
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="BasePrice" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Kişi Başı Fiyat</label>
                    <input asp-for="BasePrice" type="number" step="0.01" min="0"
                           class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 font-medium text-navy focus:border-teal focus:bg-white focus:outline-none transition" />
                </div>
                <div>
                    <label asp-for="CurrencyType" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Para Birimi</label>
                    <select asp-for="CurrencyType"
                            class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 font-medium text-navy focus:border-teal focus:bg-white focus:outline-none transition">
                        <option value="">Seçin</option>
                        <option value="TRY">TRY — Türk Lirası</option>
                        <option value="EUR">EUR — Euro</option>
                        <option value="USD">USD — Dolar</option>
                    </select>
                </div>
            </div>

           
            <details class="group rounded-xl border border-line bg-cream/30 p-5">
                <summary class="cursor-pointer list-none">
                    <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-teal-dark">
                        <span class="transition group-open:rotate-90">▸</span>
                        Tur Detayları
                        <span class="font-normal normal-case text-muted">— tip, ulaşım, konaklama, rehber, vize</span>
                    </span>
                </summary>

                <div class="mt-5 space-y-5">
                    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                        <div>
                            <label asp-for="TourType" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Tur Tipi</label>
                            <select asp-for="TourType"
                                    class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition">
                                <option value="">Seçin</option>
                                <option value="Yurt İçi">Yurt İçi</option>
                                <option value="Yurt Dışı">Yurt Dışı</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="GuideLanguage" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Rehber Dili</label>
                            <input asp-for="GuideLanguage"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy focus:border-teal focus:outline-none transition" />
                        </div>
                    </div>

                    <div>
                        <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Başlangıç Şehri</label>
                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                            <input asp-for="StartCity.Tr" placeholder="TR"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                            <input asp-for="StartCity.En" placeholder="EN"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                            <input asp-for="StartCity.Pt" placeholder="PT"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                        </div>
                    </div>

                    <div>
                        <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Ulaşım</label>
                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                            <input asp-for="Transportation.Tr" placeholder="TR"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                            <input asp-for="Transportation.En" placeholder="EN"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                            <input asp-for="Transportation.Pt" placeholder="PT"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                        </div>
                    </div>

                    <div>
                        <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Konaklama</label>
                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                            <input asp-for="Accommodation.Tr" placeholder="TR"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                            <input asp-for="Accommodation.En" placeholder="EN"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                            <input asp-for="Accommodation.Pt" placeholder="PT"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                        </div>
                    </div>

                    <div>
                        <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Vize Bilgisi</label>
                        <div class="space-y-3">
                            <input asp-for="VisaInfo.Tr" placeholder="TR"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                            <input asp-for="VisaInfo.En" placeholder="EN"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                            <input asp-for="VisaInfo.Pt" placeholder="PT"
                                   class="w-full rounded-xl border border-line bg-white px-4 py-3 font-medium text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none transition" />
                        </div>
                    </div>
                </div>
            </details>

           
            <div class="rounded-xl border border-line bg-cream/30 p-5">
                <div class="mb-4 flex items-center justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-teal-dark">Tur Tarihleri</p>
                        <p class="mt-1 text-xs text-muted">Her kalkışın kendi kontenjanı ve fiyatı olur.</p>
                    </div>
                    <button type="button" onclick="addTourDate()"
                            class="rounded-full bg-navy px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-dark">
                        + Tarih Ekle
                    </button>
                </div>

                <div id="tourDatesContainer" class="space-y-3">
                    @for (int i = 0; i < Model.TourDates.Count; i++)
                    {
                        <div class="row-item rounded-xl border border-line bg-white p-4">
                            <input type="hidden" name="TourDates[@i].Id" value="@Model.TourDates[i].Id" />
                            <input type="hidden" name="TourDates[@i].AvailableSeats" value="@Model.TourDates[i].AvailableSeats" />

                            <div class="grid grid-cols-1 gap-3 sm:grid-cols-5">
                                <div>
                                    <label class="mb-1 block text-xs font-semibold text-muted">Başlangıç</label>
                                    <input name="TourDates[@i].StartDate" type="date" value="@Model.TourDates[i].StartDate.ToString("yyyy-MM-dd")"
                                           class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy focus:border-teal focus:outline-none" />
                                </div>
                                <div>
                                    <label class="mb-1 block text-xs font-semibold text-muted">Bitiş</label>
                                    <input name="TourDates[@i].EndDate" type="date" value="@Model.TourDates[i].EndDate.ToString("yyyy-MM-dd")"
                                           class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy focus:border-teal focus:outline-none" />
                                </div>
                                <div>
                                    <label class="mb-1 block text-xs font-semibold text-muted">Kontenjan</label>
                                    <input name="TourDates[@i].Quota" type="number" min="1" value="@Model.TourDates[i].Quota"
                                           class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy focus:border-teal focus:outline-none" />
                                </div>
                                <div>
                                    <label class="mb-1 block text-xs font-semibold text-muted">Fiyat</label>
                                    <input name="TourDates[@i].Price" type="number" step="0.01" value="@Model.TourDates[i].Price"
                                           class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy focus:border-teal focus:outline-none" />
                                </div>
                                <div class="flex items-end gap-2">
                                    <div class="flex-1">
                                        <label class="mb-1 block text-xs font-semibold text-muted">Durum</label>
                                        <select name="TourDates[@i].Status"
                                                class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy focus:border-teal focus:outline-none">
                                            <option value="Açık" selected="@(Model.TourDates[i].Status == "Açık")">Açık</option>
                                            <option value="Doldu" selected="@(Model.TourDates[i].Status == "Doldu")">Doldu</option>
                                            <option value="İptal" selected="@(Model.TourDates[i].Status == "İptal")">İptal</option>
                                        </select>
                                    </div>
                                    <button type="button" onclick="removeRow(this, 'tourDatesContainer')"
                                            class="rounded-lg border border-line px-3 py-2 text-sm font-semibold text-red-600 hover:border-red-600">
                                        ✕
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

           
            <div class="rounded-xl border border-line bg-cream/30 p-5">
                <div class="mb-4 flex items-center justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-teal-dark">Gün Gün Program</p>
                        <p class="mt-1 text-xs text-muted">Tur detayında accordion olarak gösterilir.</p>
                    </div>
                    <button type="button" onclick="addItineraryDay()"
                            class="rounded-full bg-navy px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-dark">
                        + Gün Ekle
                    </button>
                </div>

                <div id="itineraryContainer" class="space-y-3">
                    @for (int i = 0; i < Model.Itinerary.Count; i++)
                    {
                        <div class="row-item rounded-xl border border-line bg-white p-4">
                            <div class="mb-3 flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <label class="text-xs font-semibold text-muted">Gün</label>
                                    <input name="Itinerary[@i].DayNumber" type="number" min="1" value="@Model.Itinerary[i].DayNumber"
                                           class="w-16 rounded-lg border border-line px-2 py-1 text-sm font-bold text-navy focus:border-teal focus:outline-none" />
                                </div>
                                <button type="button" onclick="removeRow(this, 'itineraryContainer')"
                                        class="rounded-lg border border-line px-3 py-1 text-sm font-semibold text-red-600 hover:border-red-600">
                                    ✕
                                </button>
                            </div>

                            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                                <input name="Itinerary[@i].Title.Tr" value="@Model.Itinerary[i].Title?.Tr" placeholder="Başlık (TR)"
                                       class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none" />
                                <input name="Itinerary[@i].Title.En" value="@Model.Itinerary[i].Title?.En" placeholder="Title (EN)"
                                       class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none" />

                                <textarea name="Itinerary[@i].Description.Tr" rows="3" placeholder="Açıklama (TR)"
                                      class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none">@Model.Itinerary[i].Description?.Tr</textarea>
                                <textarea name="Itinerary[@i].Description.En" rows="3" placeholder="Description (EN)"
                                      class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none">@Model.Itinerary[i].Description?.En</textarea>

                                <input name="Itinerary[@i].City.Tr" value="@Model.Itinerary[i].City?.Tr" placeholder="Şehir (TR)"
                                       class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none" />
                                <input name="Itinerary[@i].City.En" value="@Model.Itinerary[i].City?.En" placeholder="City (EN)"
                                       class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none" />

                                <input name="Itinerary[@i].Transportation.Tr" value="@Model.Itinerary[i].Transportation?.Tr" placeholder="Ulaşım (TR)"
                                       class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none" />
                                <input name="Itinerary[@i].Meals.Tr" value="@Model.Itinerary[i].Meals?.Tr" placeholder="Yemekler (TR)"
                                       class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none" />
                            </div>
                        </div>
                    }
                </div>
            </div>

           
            <div class="rounded-xl border border-line bg-cream/30 p-5">
                <div class="mb-4 flex items-center justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-teal-dark">Öne Çıkan Özellikler</p>
                        <p class="mt-1 text-xs text-muted">Tur kartında ikonlarla gösterilir.</p>
                    </div>
                    <button type="button" onclick="addAmenity()"
                            class="rounded-full bg-navy px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-dark">
                        + Özellik Ekle
                    </button>
                </div>

                <div id="amenitiesContainer" class="space-y-3">
                    @for (int i = 0; i < Model.Amenities.Count; i++)
                    {
                        <div class="row-item flex gap-3">
                            <input name="Amenities[@i].Name" value="@Model.Amenities[i].Name"
                                   class="flex-1 rounded-lg border border-line bg-white px-3 py-2 text-sm text-navy focus:border-teal focus:outline-none" />
                            <input name="Amenities[@i].Icon" value="@Model.Amenities[i].Icon"
                                   class="w-40 rounded-lg border border-line bg-white px-3 py-2 text-sm text-navy focus:border-teal focus:outline-none" />
                            <button type="button" onclick="removeRow(this, 'amenitiesContainer')"
                                    class="rounded-lg border border-line px-3 py-2 text-sm font-semibold text-red-600 hover:border-red-600">
                                ✕
                            </button>
                        </div>
                    }
                </div>
            </div>

           
            <div>
                <label asp-for="ImageFile" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Kapak Görselini Değiştir</label>
                <input asp-for="ImageFile" type="file" accept="image/*"
                       class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 text-sm text-navy file:mr-4 file:rounded-full file:border-0 file:bg-teal file:px-5 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-teal-dark focus:border-teal focus:bg-white focus:outline-none transition" />
                <p class="mt-1.5 text-xs text-muted">Boş bırakırsan mevcut görsel korunur.</p>
            </div>

            @if (!string.IsNullOrEmpty(Model?.ThumbnailUrl))
            {
                <div>
                    <p class="mb-2 text-xs font-bold uppercase tracking-wider text-muted">Mevcut Kapak</p>
                    <img src="@Model.ThumbnailUrl" alt="" class="h-40 w-full max-w-md rounded-xl object-cover" />
                </div>
            }

           
            <div>
                <label asp-for="GalleryFiles" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-muted">Galeriye Görsel Ekle</label>
                <input asp-for="GalleryFiles" type="file" accept="image/*" multiple
                       class="w-full rounded-xl border border-line bg-cream/40 px-4 py-3 text-sm text-navy file:mr-4 file:rounded-full file:border-0 file:bg-teal file:px-5 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-teal-dark focus:border-teal focus:bg-white focus:outline-none transition" />
                <p class="mt-1.5 text-xs text-muted">Seçtiklerin mevcut galeriye eklenir.</p>
            </div>

            @if (Model.Images.Any())
            {
                <div>
                    <p class="mb-2 text-xs font-bold uppercase tracking-wider text-muted">Mevcut Galeri — @Model.Images.Count görsel</p>
                    <div class="flex flex-wrap gap-2">
                        @for (int i = 0; i < Model.Images.Count; i++)
                        {
                            <div>
                                <img src="@Model.Images[i].Url" class="h-24 w-32 rounded-lg object-cover" />
                                <input type="hidden" name="Images[@i].Url" value="@Model.Images[i].Url" />
                                <input type="hidden" name="Images[@i].Order" value="@Model.Images[i].Order" />
                                <input type="hidden" name="Images[@i].IsCover" value="@Model.Images[i].IsCover.ToString().ToLower()" />
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- DURUM -->
            <div class="space-y-3 border-t border-line pt-5">
                <label class="flex cursor-pointer items-center gap-3">
                    <input asp-for="IsActive" type="checkbox" class="h-5 w-5 rounded border-line text-teal focus:ring-teal" />
                    <span class="text-sm font-medium text-navy">Yayında olsun</span>
                </label>

                <label class="flex cursor-pointer items-center gap-3">
                    <input asp-for="IsFeatured" type="checkbox" class="h-5 w-5 rounded border-line text-teal focus:ring-teal" />
                    <span class="text-sm font-medium text-navy">Ana sayfada öne çıkar</span>
                </label>
            </div>

            <div class="flex gap-3 border-t border-line pt-5">
                <button type="submit" class="rounded-full bg-teal px-7 py-3 font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-teal-dark">
                    Güncelle
                </button>
                <a asp-action="Index" class="rounded-full border border-line px-6 py-3 font-semibold text-navy transition hover:border-navy">
                    İptal
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // ── TUR TARİHLERİ ──
        function addTourDate() {
            const c = document.getElementById('tourDatesContainer');
            const i = c.children.length;

            const row = document.createElement('div');
            row.className = 'row-item rounded-xl border border-line bg-white p-4';
            row.innerHTML = `
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-5">
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-muted">Başlangıç</label>
                        <input name="TourDates[${i}].StartDate" type="date"
                               class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy focus:border-teal focus:outline-none" />
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-muted">Bitiş</label>
                        <input name="TourDates[${i}].EndDate" type="date"
                               class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy focus:border-teal focus:outline-none" />
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-muted">Kontenjan</label>
                        <input name="TourDates[${i}].Quota" type="number" min="1" value="20"
                               class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy focus:border-teal focus:outline-none" />
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-muted">Fiyat</label>
                        <input name="TourDates[${i}].Price" type="number" step="0.01" min="0"
                               class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy focus:border-teal focus:outline-none" />
                    </div>
                    <div class="flex items-end gap-2">
                        <div class="flex-1">
                            <label class="mb-1 block text-xs font-semibold text-muted">Durum</label>
                            <select name="TourDates[${i}].Status"
                                    class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy focus:border-teal focus:outline-none">
                                <option value="Açık">Açık</option>
                                <option value="Doldu">Doldu</option>
                                <option value="İptal">İptal</option>
                            </select>
                        </div>
                        <button type="button" onclick="removeRow(this, 'tourDatesContainer')"
                                class="rounded-lg border border-line px-3 py-2 text-sm font-semibold text-red-600 hover:border-red-600">
                            ✕
                        </button>
                    </div>
                </div>`;
            c.appendChild(row);
        }

        // ── GÜN GÜN PROGRAM ──
        function addItineraryDay() {
            const c = document.getElementById('itineraryContainer');
            const i = c.children.length;

            const row = document.createElement('div');
            row.className = 'row-item rounded-xl border border-line bg-white p-4';
            row.innerHTML = `
                <div class="mb-3 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <label class="text-xs font-semibold text-muted">Gün</label>
                        <input name="Itinerary[${i}].DayNumber" type="number" min="1" value="${i + 1}"
                               class="w-16 rounded-lg border border-line px-2 py-1 text-sm font-bold text-navy focus:border-teal focus:outline-none" />
                    </div>
                    <button type="button" onclick="removeRow(this, 'itineraryContainer')"
                            class="rounded-lg border border-line px-3 py-1 text-sm font-semibold text-red-600 hover:border-red-600">
                        ✕
                    </button>
                </div>

                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <input name="Itinerary[${i}].Title.Tr" placeholder="Başlık (TR) — İstanbul → Roma"
                           class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none" />
                    <input name="Itinerary[${i}].Title.En" placeholder="Title (EN)"
                           class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none" />

                    <textarea name="Itinerary[${i}].Description.Tr" rows="3" placeholder="Açıklama (TR)"
                              class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none"></textarea>
                    <textarea name="Itinerary[${i}].Description.En" rows="3" placeholder="Description (EN)"
                              class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none"></textarea>

                    <input name="Itinerary[${i}].City.Tr" placeholder="Şehir (TR)"
                           class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none" />
                    <input name="Itinerary[${i}].City.En" placeholder="City (EN)"
                           class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none" />

                    <input name="Itinerary[${i}].Transportation.Tr" placeholder="Ulaşım (TR) — isteğe bağlı"
                           class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none" />
                    <input name="Itinerary[${i}].Meals.Tr" placeholder="Yemekler (TR) — isteğe bağlı"
                           class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none" />
                </div>`;
            c.appendChild(row);
        }

      
        function addAmenity() {
            const c = document.getElementById('amenitiesContainer');
            const i = c.children.length;

            const row = document.createElement('div');
            row.className = 'row-item flex gap-3';
            row.innerHTML = `
                <input name="Amenities[${i}].Name" placeholder="Uçuş Dahil"
                       class="flex-1 rounded-lg border border-line bg-white px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none" />
                <input name="Amenities[${i}].Icon" placeholder="flight"
                       class="w-40 rounded-lg border border-line bg-white px-3 py-2 text-sm text-navy placeholder:text-muted/60 focus:border-teal focus:outline-none" />
                <button type="button" onclick="removeRow(this, 'amenitiesContainer')"
                        class="rounded-lg border border-line px-3 py-2 text-sm font-semibold text-red-600 hover:border-red-600">
                    ✕
                </button>`;
            c.appendChild(row);
        }


        function removeRow(btn, containerId) {
            btn.closest('.row-item').remove();

            document.querySelectorAll(`#${containerId} .row-item`).forEach((row, index) => {
                row.querySelectorAll('[name]').forEach(input => {
                    input.name = input.name.replace(/\[\d+\]/, `[${index}]`);
                });
            });
        }
    </script>
}
